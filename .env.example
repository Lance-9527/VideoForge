# VideoForge · API Key 配置模板
#
# 复制本文件为 .env 并填入你自己的 key：
#     cp .env.example .env
#
# 启动 VideoForge 后，在「设置」页填入这些 key 也可以（更推荐 —— 加密存 SQLite）。
# 本文件**只用于本地开发**，请勿提交真实 key 到 git。

# ──────────── LLM（剧本生成 / 角色分析 / 资产提取 / 体检） ────────────
# MiniMax（默认 LLM）
MINIMAX_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# OpenAI / OpenAI 兼容
OPENAI_API_KEY=

# 通义千问
QWEN_API_KEY=

# 智谱 GLM
GLM_API_KEY=

# 月之暗面 Kimi
KIMI_API_KEY=

# 火山方舟 Doubao
DOUBAO_API_KEY=

# Ollama（本地）
OLLAMA_BASE_URL=http://localhost:11434

# ──────────── 视频模型（按需启用，不需要可留空） ────────────
MINIMAX_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
JIMENG_ACCESS_KEY=
JIMENG_SECRET_KEY=
HAILUO_API_KEY=
COGVIDEOX_API_KEY=
RUNWAY_API_KEY=
PIKA_API_KEY=
LUMA_API_KEY=
SORA_API_KEY=
WANX_API_KEY=
SEEDANCE_API_KEY=

# ──────────── TTS / 配音 ────────────
# Edge TTS 零配置，无需 key
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# SiliconFlow
SILICONFLOW_API_KEY=
SILICONFLOW_VOICE=

# DashScope
DASHSCOPE_API_KEY=

# ──────────── 路径覆盖 ────────────
# 数据目录（默认 %LOCALAPPDATA%\VideoForge\data）
# VIDEOFORGE_DATA_DIR=D:/VideoForge/data

# 自定义 FFmpeg 路径（不填则自动探测）
# VIDEOFORGE_FFMPEG=D:/tools/ffmpeg/bin/ffmpeg.exe