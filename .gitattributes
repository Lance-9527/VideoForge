# Normalize line endings for cross-platform collaboration
* text=auto eol=lf

# Python source: enforce LF
*.py        text eol=lf
*.pyi       text eol=lf

# Shell / batch: preserve platform-native
*.sh        text eol=lf
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Markdown / docs
*.md        text eol=lf

# Frontend
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.json      text eol=lf

# Binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.mp4       binary
*.mp3       binary
*.wav       binary
*.pdf       binary
*.db        binary
*.exe       binary
*.pyd       binary
*.dll       binary

# Diff & merge driver hints
requirements.txt merge=union
package.json  merge=union