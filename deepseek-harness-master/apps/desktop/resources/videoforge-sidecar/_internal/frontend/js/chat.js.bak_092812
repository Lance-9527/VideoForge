/**
 * VideoForge · 对话模块
 * 与 AI Agent 流式对话
 */

/**
 * 哪些工具**写资产/分镜** —— 它们成功后要通知资产页重取数据。
 *
 * ★ 2026-09-27 第 71 轮加。用户实测原话：
 *   「我手动删了资产后让对话重加还是看不到我要的资产」。
 *   根因不是数据没写进去，而是**界面不知道要重取**：
 *   用户站在「资产」页上，对话在另一个 section 里跑完 ——
 *   没有切页就永远不会重新请求，看上去就是"AI 说加好了，界面还是空的"。
 */
const _ASSET_WRITING_TOOLS = new Set([
  'extract_assets', 'add_asset', 'import_script', 'generate_script',
  'plan_shots', 'make_looks', 'make_character_look', 'make_scene_look',
  'refine_look', 'set_shot_transition', 'delete_asset',
]);

/**
 * 把一条消息的 markdown 渲染成 HTML（**只转义一次**）。
 *
 * ★★ 2026-09-27 第 72 轮：修「对话框给用户看乱码」。
 *
 * 用户看到的是这样一坨（截图里就是这个）：
 *     {&quot;tool&quot;: &quot;list_shots&quot;, &quot;args&quot;: {...}}
 *
 * 根因是**转义了两次**：
 *     ① 先把整条消息 `escapeHtml()` → 里面的 `"` 变成 `&quot;`
 *     ② 再对代码块的内容 `escapeHtml(code)` → 那个 `&quot;` 里的 `&`
 *        又变成 `&amp;`，于是变成 `&amp;quot;`
 *     ③ 浏览器渲染 `&amp;quot;` → 屏幕上就是字面量 `&quot;`
 * 于是**任何**代码块里的引号都会变成乱码 —— 模型给的 JSON、命令、代码全中招。
 *
 * 修法：先把代码块**挖出来存好**（用占位符顶位），整条只转义一次，
 * 最后再把每个代码块**单独转义一次**填回去。每段文本都是一次转义，不多不少。
 */
function renderMarkdownOnce(raw) {
  const blocks = [];
  let s = String(raw == null ? '' : raw);
  // ① 挖出代码块（此时还没转义，拿到的是原文）
  s = s.replace(/```(\w*)\n?([\s\S]*?)```/g, (m, lang, code) => {
    blocks.push({ lang: lang || '', code: code });
    return '\u0000VFCODE' + (blocks.length - 1) + '\u0000';
  });
  // ② 整条转义一次
  let html = escapeHtml(s);
  // ③ 行内代码 / 粗体
  html = html.replace(/`([^`\n]+)`/g, '<code class="msg-inline-code">$1</code>');
  html = html.replace(/\*\*([^\*]+)\*\*/g, '<strong>$1</strong>');

  // ★★★ 2026-09-29（用户第 3 条：「用户体验极差」+ 截图里那一片生pipe）
  //
  //   实测截图：AI 回了一堆 `| 项目 | 建议 |`、`## 角色（10 个）`，
  //   而这里是**原样**显示的 —— 因为渲染器只认行内代码、粗体和 `- ` 列表。
  //   更糟的是：我这一轮让 AI「真的去查、然后汇报」，它就**更爱用表格**了，
  //   于是这个短板更明显。用户看到的就是一堆竖线和井号。
  //
  //   所以在转 <br> **之前**补上：GFM 表格、`#` 标题、`1.` 有序列表。
  //   注意顺序：表格必须在换行转换之前处理，否则行内换行会把它打断。
  //   安全性不变：内容在 ② 已经整体转义过一次，这里只拼结构、不再插原文。
  //
  // ③a 表格：`| a | b |` + `|---|` 分隔行 + 若干 `| ... |` 数据行
  html = html.replace(
    /(^\|[^\n]*\|[ \t]*\n\|[ \t:\-|]+\|[ \t]*\n(?:\|[^\n]*\|[ \t]*\n?)*)/gm,
    (block) => {
      const lines = String(block).replace(/\n+$/, '').split('\n')
        .filter(l => l.trim());
      if (lines.length < 2) return block;
      const cells = (l) => l.trim().replace(/^\|/, '').replace(/\|$/, '')
        .split('|').map(c => c.trim());
      const head = cells(lines[0]);
      const body = lines.slice(2).map(cells);
      return '<div class="msg-table-wrap"><table class="msg-table"><thead><tr>'
        + head.map(c => '<th>' + c + '</th>').join('')
        + '</tr></thead><tbody>'
        + body.map(r => '<tr>' + r.map(c => '<td>' + c + '</td>').join('') + '</tr>')
            .join('')
        + '</tbody></table></div>';
    });
  // ③b 标题：`## x` → h3（模型很爱用它分段）
  html = html.replace(/^(#{1,6})[ \t]+(.+)$/gm,
    (m, hashes, txt) => '<h3 class="msg-h">' + txt + '</h3>');
  // ③c 无序 / 有序列表
  html = html.replace(/^[ \t]*[-*][ \t]+(.+)$/gm, '<li>$1</li>');
  html = html.replace(/^[ \t]*(\d+)[.)][ \t]+(.+)$/gm, '<li class="msg-oli">$2</li>');
  html = html.replace(/(<li>.*<\/li>\n?)+/g, '<ul>$&</ul>');
  html = html.replace(/(<li class="msg-oli">.*<\/li>\n?)+/g,
    (m) => '<ol>' + m.replace(/ class="msg-oli"/g, '') + '</ol>');
  html = html.replace(/\n/g, '<br>');
  // ④ 代码块填回去（**各自只转义一次**）
  html = html.replace(/\u0000VFCODE(\d+)\u0000/g, (m, i) => {
    const b = blocks[Number(i)] || { code: '' };
    return '<div class="msg-code-wrapper">'
         + '<button class="msg-code-copy">复制</button>'
         + '<pre class="msg-code">' + escapeHtml(b.code) + '</pre></div>';
  });
  return html;
}

const Chat = {
messages: [],         // 当前会话消息
  conversations: [],    // 会话列表（持久化）
  currentConvId: null,
  llmProviders: [],
  currentProvider: 'deepseek',
  currentModel: 'deepseek-chat',
  currentApiKey: '',
  streaming: false,
  eventSource: null,

  async init() {
    // 对话里的「📌 存为资产」按钮：事件委托挂一次就够
    // （产物是动态插进来的，逐个绑会漏掉后插入的那些）。
    this.bindAssetSaver();
    // 待确认卡片上的「✅ 确认 / ✏️ 改一下 / ⏭ 跳过」三个按钮，同样用委托。
    // ★ 点「确认」走 HTTP 直连（/stage/confirm），不经过模型 —— 见 confirmGate 的注释。
    this.bindGateButtons();
    // ★★ 2026-09-29（用户第 1 条：「拖拉拽即可放入，或者电脑上传」）：
    //   把拖拽与粘贴接到**整个对话区**上。图片走视觉（不抽文本），
    //   其它文件照旧走"抽文本"。
    this.bindDropAndPaste();
    // 白膜确认/驳回按钮：用事件委托挂一次就够（帧图是动态插进来的，
    // 逐个绑会漏掉后插入的那些）。
    const msgBox = document.getElementById('chatMessages');
    if (msgBox && !msgBox.dataset.previzWired) {
      msgBox.dataset.previzWired = '1';
      msgBox.addEventListener('click', (e) => {
        const btn = e.target.closest('.agent-ok-btn, .agent-no-btn');
        if (!btn) return;
        const shotId = btn.dataset.shot || '';
        const act = btn.dataset.act;
        const wrap = btn.closest('.agent-previz-actions');
        if (wrap) {
          // 点过就锁住，避免连点发出两条冲突指令
          wrap.querySelectorAll('button').forEach(b => { b.disabled = true; });
        }
        if (act === 'approve') {
          this.sendMessage(`白膜我看过了，运镜和节奏没问题，就这样。确认 ${shotId}，然后去生成。`);
        } else {
          // ★ 不自己猜理由码 —— 理由码决定回退到 G1 还是 G2（也就是要不要重渲白膜），
          //   猜错就是白烧钱。让用户自己说哪里不对。
          const box = document.createElement('div');
          box.className = 'agent-ask-reason';
          box.innerHTML =
            `<div class="dim">哪里不对？选一个（这决定要重做哪一步）：</div>` +
            `<div class="agent-reason-btns">` +
            `<button class="secondary-btn" data-rc="CAMERA">运镜不对</button>` +
            `<button class="secondary-btn" data-rc="BLOCKING">走位/站位不对</button>` +
            `<button class="secondary-btn" data-rc="PACING">节奏不对</button>` +
            `<button class="secondary-btn" data-rc="LOOK">画风/色调不对</button>` +
            `<button class="secondary-btn" data-rc="IDENTITY">角色长相不对</button>` +
            `</div>` +
            `<div class="dim" style="margin-top:4px">运镜/走位/节奏 → 重渲白膜；` +
            `画风/长相 → 白膜不动，只换参考图（省钱）</div>`;
          btn.parentElement.appendChild(box);
          box.querySelectorAll('button[data-rc]').forEach(b => {
            b.addEventListener('click', () => {
              box.remove();
              const label = b.textContent.trim();
              this.sendMessage(
                `白膜不行，${label}。驳回 ${shotId}，理由码 ${b.dataset.rc}。`);
            });
          });
        }
      });
    }

    // 加载 LLM providers
    try {
      const data = await API.chatProviders();
      this.llmProviders = data.providers || [];
    } catch (e) {
      console.error('Load LLM providers failed:', e);
    }

    // 加载设置（默认 provider/model/api key）
    try {
      const settings = await API.settings.get();
      this.currentProvider = settings.llm_provider || settings.remote_llm_provider || 'deepseek';
      this.currentModel = settings.llm_model || '';
      // 找默认 provider 的 api key
      const llmKeys = settings.llm_api_keys || {};
      this.currentApiKey = llmKeys[this.currentProvider] || '';
      this.updateLlmPill();
    } catch (e) {
      console.error('Load settings failed:', e);
    }

    // 加载会话列表
    this.loadConversations();
  },

  populateProviders() {
    // 不再需要 - 由设置面板替代
  },

  updateLlmPill() {
    // 顶部已整合为单一 ai-pill，由 app.js 的 updateModelPill() 负责渲染。
    // 这里只做安全更新（元素可能不存在），并触发 app 的全局刷新。
    try {
      if (typeof window.updateModelPill === 'function') {
        window.updateModelPill();
      }
    } catch (e) {
      // ignore
    }
  },

  loadConversations() {
    // 优先从服务端加载；失败则回退 localStorage
    API.listConversations()
      .then(d => {
        if (d && d.conversations && d.conversations.length) {
          this.conversations = d.conversations;
          this.renderConversations();
        } else {
          this.loadConversationsFromLocal();
        }
      })
      .catch(() => this.loadConversationsFromLocal());
  },

  loadConversationsFromLocal() {
    try {
      const stored = localStorage.getItem('vf_conversations');
      if (stored) {
        this.conversations = JSON.parse(stored);
        this.renderConversations();
      }
    } catch (e) {
      console.error('Load conversations failed:', e);
    }
  },

  saveConversations() {
    try {
      localStorage.setItem('vf_conversations', JSON.stringify(this.conversations));
    } catch (e) {
      console.error('Save conversations failed:', e);
    }
  },

  // 同步当前会话到服务端（后台静默，不阻塞 UI）
  syncToServer(conv) {
    if (!conv || !conv.id) return;
    API.upsertConversation({
      id: conv.id,
      title: conv.title || '新会话',
      messages: conv.messages || [],
    }).catch(e => console.warn('sync to server failed:', e));
  },

  deleteConvOnServer(cid) {
    API.deleteConversation(cid).catch(() => {});
  },

  renderConversations() {
    const list = document.getElementById('chatList');
    if (!list) return;
    if (!this.conversations.length) {
      list.innerHTML = '<div class="dim" style="padding: 8px 12px; font-size: 12px;">暂无会话</div>';
      return;
    }
    // 历史会话补标题：早期版本因为判断写错，所有会话都叫「新会话」，
    // 这里用第一条用户消息回填，让列表能区分开。
    let dirty = false;
    for (const c of this.conversations) {
      if (!c.title || c.title === '新会话') {
        const firstUser = (c.messages || []).find(m => m.role === 'user');
        const t = String((firstUser || {}).content || '').replace(/\s+/g, ' ').trim().slice(0, 18);
        if (t) { c.title = t; dirty = true; }
      }
    }
    if (dirty) {
      this.saveConversations();
      this.conversations.filter(c => c.title && c.title !== '新会话')
        .forEach(c => this.syncToServer(c));
    }
    list.innerHTML = this.conversations.slice(0, 20).map(c => `
      <div class="project-list-item ${c.id === this.currentConvId ? 'active' : ''}" data-cid="${c.id}"
           title="${escapeHtml(c.title || '新会话')}">
        <div class="conv-title">${escapeHtml(c.title || '新会话')}</div>
        <div class="project-status">${(c.messages || []).length} 条消息</div>
      </div>
    `).join('');
    list.querySelectorAll('[data-cid]').forEach(el => {
      el.addEventListener('click', () => this.loadConversation(el.dataset.cid));
    });
  },

  newConversation() {
    this.currentConvId = 'c_' + Date.now();
    this.messages = [];
    document.getElementById('chatMessages').innerHTML = '';
    document.getElementById('chatWelcome').style.display = '';
    this.conversations.unshift({
      id: this.currentConvId,
      title: '新会话',
      messages: [],
      created_at: new Date().toISOString(),
    });
    this.saveConversations();
    this.renderConversations();
  },

  loadConversation(cid) {
    // 立即可见的反馈：先切到对话页 + 高亮 + 本地缓存渲染（避免"点击没反应"）
    const applyLocal = () => {
      const conv = this.conversations.find(c => c.id === cid);
      this.currentConvId = cid;
      this.messages = (conv && conv.messages) || [];
      this.renderMessages();
      this.renderConversations();
    };

    // 1) 先切页（无论后端快慢，用户立刻看到跳转）
    if (typeof window.navigateTo === 'function') window.navigateTo('chat');
    this.currentConvId = cid;
    this.renderConversations();          // 立刻高亮选中项
    applyLocal();                        // 立刻用本地缓存渲染

    // 2) 再从服务端拉取最新（成功则覆盖，失败保留本地渲染，并提示）
    //    注意：API.request() 已解包 data，这里拿到的就是会话对象本身
    API.getConversation(cid)
      .then(d => {
        if (!d) { return; }              // 服务端无此会话：保留本地渲染
        const conv = this.conversations.find(c => c.id === cid);
        if (conv) {
          conv.messages = d.messages || conv.messages || [];
          conv.title = d.title || conv.title;
        }
        this.messages = d.messages || this.messages || [];
        this.renderMessages();
        this.renderConversations();
      })
      .catch(e => {
        // 网络/超时/业务错误：本地渲染已生效，仅提示，不阻塞界面
        console.warn('load conversation from server failed:', e);
        if (window.Toast) Toast.warn('会话已加载（本地缓存）；服务端同步失败：' + (e.message || e));
      });
  },

  renderMessages() {
    const container = document.getElementById('chatMessages');
    if (!this.messages.length) {
      container.innerHTML = '';
      document.getElementById('chatWelcome').style.display = '';
      return;
    }
    document.getElementById('chatWelcome').style.display = 'none';
    container.innerHTML = this.messages.map((m, i) => this.renderMessage(m, i)).join('');
    this.scrollToBottom(true);   // ★ 打开/切回会话：**直接**停在最新消息（不要从顶部滑）
    // ★ 点缩略图 → 全屏看（事件委托，只绑一次；重绘不会重复绑）
    if (!container.dataset.mediaBound) {
      container.dataset.mediaBound = '1';
      container.addEventListener('click', (e) => {
        const cell = e.target.closest && e.target.closest('.msg-media-cell[data-media]');
        if (!cell) return;
        this.openMedia(cell.dataset.media, cell.dataset.kind || 'image');
      });
    }
    // 重新绑定代码块复制按钮
    container.querySelectorAll('[data-copy-idx]').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.dataset.copyIdx);
        const code = this.messages[idx].content;
        navigator.clipboard.writeText(code);
        Toast.success('已复制');
      });
    });
  },

  renderMessage(m, idx) {
    const isUser = m.role === 'user';
    const avatar = isUser ? '👤' : '🎬';
    const time = new Date(m.timestamp || Date.now()).toLocaleTimeString('zh-CN', {
      hour: '2-digit', minute: '2-digit',
    });

    // markdown 渲染：**只转义一次**（见 `renderMarkdownOnce` 的说明 —— 原来
    // 转义两次，代码块里的引号会变成字面量 `&quot;`，用户看到的全是乱码）
    // ★ 2026-09-28：显示前先把**工具调用 JSON** 摘掉（用户第 4 条：
    //   「对话过程中代码不要出现」）。数据不变，只是不给他看代码。
    let content = renderMarkdownOnce(_extractPlannedTool(m.content).cleaned);

    // ★ 把这一轮执行过的工具**重新画出来**。
    //   为什么必须重画：产物卡片（白膜帧、定妆照、成片、下载/存资产按钮）
    //   都是 pushTrace 在流式过程中塞进 DOM 的，从不进 this.messages。
    //   于是用户刷新页面 / 切走再切回来，所有图和「下载」「存资产库」按钮
    //   全都不见了 —— 只剩一句 ✓ 和一串工具名。
    //   现在把 {tool, ok, data} 一起存下来，重开时按同样规则渲染一遍。
    let trace = '';
    if (!isUser && Array.isArray(m.steps) && m.steps.length) {
      trace = this.stepsToHTML(m.steps);
    }

    // ★★ 2026-09-27 第 46 轮（用户第 4 条）：对话里**直接看到图片和视频**。
    //   原来图片/视频只在工具结果卡片里出现（而且切走再回来就没了），
    //   用户的原话是「AI对话框还是不支持看图片和视频，我需要直接支持到
    //   对话框里面直接点击查看才行」。
    //   ⇒ 这里把这一轮**所有**媒体（图片/视频）收出来，在消息正文下面
    //     排一排缩略图：点一下全屏看（灯箱），视频带播放控件。
    const media = this.mediaBlockHTML(m);

    return `
      <div class="msg ${isUser ? 'msg-user' : 'msg-assistant'}">
        <div class="msg-avatar">${avatar}</div>
        <div class="msg-body">
          <div class="msg-header">
            <span class="msg-name">${isUser ? '你' : 'VideoForge AI'}</span>
            <span class="msg-model">${m.model || ''}</span>
            <span class="msg-time">${time}</span>
          </div>
          ${trace}
          <div class="msg-content">${content}</div>
          ${media}
        </div>
      </div>
    `;
  },

  // ──────────────── 消息里的图片 / 视频（第 4 条）────────────────
  /** 把一个路径/URL 变成能播能看的媒体项；不是媒体就返回 null。 */
  /**
   * 把工具结果里的**任意**字符串转成可渲染的媒体项。
   *
   * ★★ 2026-09-27 第 72 轮：修「对话框里的视频看不了」（用户第 1 条）。
   *
   * 旧实现只按"**问号前**那段"判扩展名：
   *     const low = s.toLowerCase().split('?')[0];   // ← 对 /api/media?path=x.mp4 得到 "/api/media"
   *     if (!isImg && !isVid) return null;           // ⇒ 直接丢掉
   * 后果：**我们后端自己返回的 url（`/api/media?path=...mp4`）全被丢掉**，
   * 反而是裸的 Windows 路径能显示 —— 于是"有的视频能看、有的看不了"。
   * 正确判据是**看 path 参数里的真实文件名**（解码后），并且要容忍
   * `&download=1` 这类附加参数（旧的正则要求 `.mp4` 后面只能是 ?/#/结尾）。
   */
  _asMedia(v) {
    const s = String(v || '').trim();
    if (!s || s.length > 1200) return null;
    let probe = s;
    // /api/media?path=<编码过的本地路径> → 用解码后的路径判类型
    const m = /\/api\/media\?[^]*?\bpath=([^&]*)/i.exec(s);
    if (m) {
      try { probe = decodeURIComponent(m[1]); } catch (e) { probe = m[1]; }
    }
    const low = probe.toLowerCase().replace(/\s+$/, '');
    const isImg = /\.(png|jpe?g|webp|gif|bmp)$/.test(low);
    const isVid = /\.(mp4|mov|webm|mkv|m4v|avi)$/.test(low);
    if (!isImg && !isVid) return null;
    let url = s;
    if (/^https?:\/\//i.test(s)) url = s;
    else if (s.startsWith('/api/')) url = s;
    else url = '/api/media?path=' + encodeURIComponent(s);
    return { url, kind: isVid ? 'video' : 'image', name: probe.split(/[\\/]/).pop() };
  },

  /** 从一条消息的正文 + 工具结果里收集媒体（去重，最多 12 个）。
   *
   * ★★ 2026-09-27 第 56 轮：**这个方法原来叫 `_collectMedia`，与本文件
   *    1472 行那个旧的 `_collectMedia(tool, d)` 重名** —— 对象字面量里
   *    后写的覆盖先写的，于是 `renderMessage` 调到的是**旧版**（第二个参数
   *    undefined）⇒ **对话里永远看不到图片和视频** ✗✗
   *    （用户的原话：「对话框无法呈现图片、视频，这个问题特别大」。）
   *    实测证据：库里那条助手消息的步骤里**确实带着 `path`**（图片文件在），
   *    只是从没被渲染出来。
   *    ⇒ 改名避免撞车；并且给前端接线守卫**加了一条"不许重名成员"**，
   *      以后这一类不可能再溜过去。
   */
  _collectMessageMedia(m) {
    const out = [];
    const seen = new Set();
    const push = (v) => {
      const it = this._asMedia(v);
      if (it && !seen.has(it.url)) { seen.add(it.url); out.push(it); }
    };
    // ① 正文里出现的 /api/media?... 或 绝对路径
    const text = String(m.content || '');
    (text.match(/\/api\/media\?path=[^\s"')\]]+/g) || []).forEach(push);
    (text.match(/[A-Za-z]:\\[^\s"'*?<>|]+?\.(?:png|jpe?g|webp|mp4|mov|webm)/gi) || []).forEach(push);
    // ② 工具结果里的媒体字段（递归找，键名不限 —— 各工具叫法不一样）
    const walk = (o, depth) => {
      if (!o || depth > 5 || out.length >= 12) return;
      if (typeof o === 'string') { push(o); return; }
      if (Array.isArray(o)) { o.forEach(x => walk(x, depth + 1)); return; }
      if (typeof o !== 'object') return;
      Object.keys(o).forEach(k => {
        const v = o[k];
        if (typeof v === 'string') push(v);
        else if (v && typeof v === 'object') walk(v, depth + 1);
      });
    };
    (m.steps || []).forEach(s => { if (s && s.ok !== false) walk(s.data, 0); });
    return out.slice(0, 12);
  },

  /** 媒体条：缩略图（图）/ 播放器（视频），点击全屏。 */
  mediaBlockHTML(m) {
    let items = [];
    try { items = this._collectMessageMedia(m); } catch (e) { console.warn('[chat] 收集媒体失败：', e); }
    if (!items.length) return '';
    const esc = escapeHtml;
    const cells = items.map((it, i) => {
      const label = esc(it.name || '');
      if (it.kind === 'video') {
        return `<div class="msg-media-cell" data-media="${esc(it.url)}" data-kind="video">
            <video src="${esc(it.url)}" preload="metadata" muted></video>
            <span class="msg-media-tag">▶ 视频</span>
            <span class="msg-media-name">${label}</span>
          </div>`;
      }
      return `<div class="msg-media-cell" data-media="${esc(it.url)}" data-kind="image">
          <img src="${esc(it.url)}" loading="lazy" alt="${label}">
          <span class="msg-media-name">${label}</span>
        </div>`;
    }).join('');
    return `<div class="msg-media"><div class="msg-media-hint">点一下放大看（共 ${items.length} 个）</div>
      <div class="msg-media-row">${cells}</div></div>`;
  },

  /** 点击缩略图 → 全屏看（灯箱）。视频带控件、点背景关掉。 */
  openMedia(url, kind) {
    let ov = document.getElementById('vfMediaOverlay');
    if (!ov) {
      ov = document.createElement('div');
      ov.id = 'vfMediaOverlay';
      ov.className = 'vf-media-overlay';
      ov.addEventListener('click', (e) => {
        if (e.target === ov || e.target.classList.contains('vf-media-close')) {
          ov.style.display = 'none';
          const v = ov.querySelector('video');
          if (v) v.pause();
        }
      });
      document.body.appendChild(ov);
    }
    ov.innerHTML = `<span class="vf-media-close">✕ 关闭</span>`
      + (kind === 'video'
        ? `<video src="${escapeHtml(url)}" controls autoplay></video>`
        : `<img src="${escapeHtml(url)}" alt="预览">`);
    ov.style.display = 'flex';
  },

  /** 每一步的秒表（第 7 条：等待要有进度感）。 */
  startElapsedTimer(row) {
    const el = row && row.querySelector('.agent-elapsed');
    if (!el) return;
    const t0 = Number(el.dataset.t0 || Date.now());
    if (row._elapsedTimer) clearInterval(row._elapsedTimer);
    const tick = () => {
      const s = Math.max(0, Math.round((Date.now() - t0) / 1000));
      el.textContent = s < 60 ? (s + ' 秒') : (Math.floor(s / 60) + ' 分 ' + (s % 60) + ' 秒');
    };
    tick();
    row._elapsedTimer = setInterval(tick, 1000);
  },

  stopElapsedTimer(row) {
    if (!row) return;
    if (row._elapsedTimer) { clearInterval(row._elapsedTimer); row._elapsedTimer = null; }
    const el = row.querySelector('.agent-elapsed');
    if (el) el.remove();
  },

  /** 把存下来的工具轨迹渲染成与实时流一致的 DOM（供重开会话时复原） */
  stepsToHTML(steps) {
    const esc = escapeHtml;
    const rows = (steps || []).map(s => {
      const label = this.toolLabel(s.tool) || s.tool || '';
      const ok = s.ok !== false;
      let extra = '';
      const d = s.data;
      if (!ok) {
        extra = `<div class="agent-err">${esc(String((d && d.error) || '执行失败'))}</div>`;
      } else if (d && typeof d === 'object') {
        // 历史里可能存着渲染失败的情况 —— 复原时不能再让它把整页搞崩
        try { extra = this.renderResultDetail(s.tool || '', d); } catch (e) { extra = ''; }
      }
      return `<div class="agent-step" data-tool="${esc(s.tool || '')}">
        <span class="agent-step-icon">${ok ? '✓' : '✗'}</span>
        <span class="agent-step-tool">${esc(label)}</span>
        ${extra}
      </div>`;
    }).join('');
    return rows ? `<div class="agent-trace">${rows}</div>` : '';
  },

  // ──────────────── 附件：图片 / txt / Word / PDF / Excel（第 42 轮）────────────────
  // 用户要求：「对话框要支持图片、文件（txt、word、pdf等格式的）支持输入，
  //           而且能读取和识别」。
  //
  // 分工（刻意这样切）：
  //   · **后端抽文本**：`POST /api/chat/attach` → `core/attachments.py`
  //     （docx 走 python-docx、pdf 走 fitz、xlsx 走 openpyxl、
  //       txt 会自动试 UTF-8/GBK —— 中文 Windows 上这点很要紧）。
  //   · **前端只做两件事**：上传 + 把抽出来的正文**并进这条消息**。
  //     为什么并进消息、不另开协议：agent 那侧一行都不用改 ——
  //     它看到的只是"用户发来一段带【附件：…】标记的文字"。
  //     改动面最小，出错的可能也最小。
  //   · 读不出来的附件**照样带上**（block 里是一句 ⚠ 说明），
  //     这样模型会主动告诉用户"这个文件我没读到"，而不是假装读过。
  attachments: [],
  //: 图片附件（与文档附件分开）：它们**不走"抽文本"**，而是作为图像块发给模型
  images: [],

  /** 图片类附件：走视觉，不抽文本 */
  isImageFile(f) {
    const n = String((f && (f.name || f.type)) || '').toLowerCase();
    return /\.(png|jpe?g|webp|gif|bmp)$/.test(n) || n.startsWith('image/');
  },

  pickAttachments() {
    const el = document.getElementById('chatFileInput');
    if (el) el.click();
  },

  /**
   * 拖拽 / 粘贴进来的图片（用户第 1 条：「拖拉拽即可放入，或者电脑上传」）。
   * 统一走 `uploadAttachments`，不另写一套上传逻辑。
   */
  onDroppedFiles(files) {
    const list = Array.from(files || []);
    if (!list.length) return;
    if (window.Toast) Toast.info(`收到 ${list.length} 个文件，正在上传…`);
    this.uploadAttachments(list);
  },

  /**
   * 把「拖进来」和「Ctrl+V 粘贴」接到整个对话区上。
   *
   * ★ 只挂一次（用 dataset 标记）—— 这个仓库里"重复挂监听"造成过
   *   "一次上传变成三次"的问题。
   * ★ 必须 `preventDefault`：不然浏览器会**直接用那张图替换整个页面**
   *   （用户看到的是软件白屏，以为崩了）。
   * ★ 拖拽时给个视觉反馈（虚线框），否则用户不知道能不能放。
   */
  bindDropAndPaste() {
    const zone = document.getElementById('chatMessages')
      || document.getElementById('chatPage')
      || document.body;
    if (zone && !zone.dataset.dropWired) {
      zone.dataset.dropWired = '1';
      const on = (e) => {
        e.preventDefault();
        e.stopPropagation();
        zone.style.outline = '2px dashed var(--accent, #6ea8fe)';
        zone.style.outlineOffset = '-6px';
      };
      const off = (e) => {
        if (e) { e.preventDefault(); e.stopPropagation(); }
        zone.style.outline = '';
      };
      zone.addEventListener('dragenter', on);
      zone.addEventListener('dragover', on);
      zone.addEventListener('dragleave', off);
      zone.addEventListener('drop', (e) => {
        off(e);
        const dt = e.dataTransfer;
        const files = dt && (dt.files && dt.files.length
          ? dt.files
          : (dt.items ? Array.from(dt.items)
              .filter(i => i.kind === 'file').map(i => i.getAsFile())
              .filter(Boolean) : []));
        this.onDroppedFiles(files);
      });
    }
    // 粘贴：截图工具/复制的图片直接粘进来（这是最常用的"放图"方式）
    const input = document.getElementById('chatInput');
    const target = input || document;
    if (target && !target.dataset.pasteWired) {
      target.dataset.pasteWired = '1';
      target.addEventListener('paste', (e) => {
        const items = (e.clipboardData && e.clipboardData.items) || [];
        const files = [];
        for (const it of items) {
          if (it.kind !== 'file') continue;
          const f = it.getAsFile();
          if (f) {
            // 截图的 name 常是 "image.png" 或空 —— 给个能看出时间的名字
            if (!f.name || f.name === 'image.png') {
              const d = new Date();
              const nm = `粘贴-${d.getHours()}${String(d.getMinutes()).padStart(2, '0')}`
                + `${String(d.getSeconds()).padStart(2, '0')}.png`;
              try { Object.defineProperty(f, 'name', { value: nm }); } catch (err) { /* 只读就算了 */ }
            }
            files.push(f);
          }
        }
        if (files.length) {
          e.preventDefault();          // 别让它粘成一大段 base64 文本
          this.onDroppedFiles(files);
        }
      });
    }
  },

  onFilesPicked(files) {
    const list = Array.from(files || []);
    if (list.length) this.uploadAttachments(list);
  },

  async uploadAttachments(files) {
    const bar = document.getElementById('chatAttachBar');
    if (bar) bar.hidden = false;
    for (const f of files) {
      const chip = document.createElement('span');
      chip.className = 'chat-attach-chip';
      chip.textContent = `⏳ ${f.name}`;
      if (bar) bar.appendChild(chip);
      try {
        const fd = new FormData();
        fd.append('file', f, f.name);
        const resp = await fetch('/api/chat/attach', { method: 'POST', body: fd });
        const j = await resp.json().catch(() => ({}));
        const d = (j && j.data) || {};
        if (!resp.ok) {
          const why = (j && j.detail && j.detail.message) || `HTTP ${resp.status}`;
          chip.textContent = `❌ ${f.name}`;
          chip.title = why;
          if (window.Toast) Toast.error(`${f.name}：${why}`);
          continue;
        }
        const isImg = this.isImageFile(f) || d.kind === 'image';
        if (isImg) {
          // 图片：登记到 images（发给模型当图像块），并显示缩略图
          this.images.push({ name: f.name, path: d.path || '' });
          chip.textContent = `🖼 ${f.name}`;
          chip.title = d.note || '会直接看图（多模态）';
          if (d.path) {
            try {
              const im = document.createElement('img');
              im.src = `/api/local-image?path=${encodeURIComponent(d.path)}`;
              im.style.cssText = 'height:26px;border-radius:4px;vertical-align:middle;margin-right:4px';
              chip.insertBefore(im, chip.firstChild);
            } catch (e) { /* 缩略图失败不影响上传 */ }
          } else {
            chip.textContent = `⚠ ${f.name}`;
          }
          if (window.Toast) Toast.success(d.note || `已收到图片 ${f.name}`);
          continue;
        }
        this.attachments.push({ name: f.name, block: d.block || '',
                                ok: !!d.ok, note: d.note || '',
                                path: d.path || '' });
        chip.textContent = `${d.ok ? '📎' : '⚠'} ${f.name}`;
        chip.title = d.note || '';
        if (d.ok) {
          if (window.Toast) Toast.success(d.note || `已读取 ${f.name}`);
        } else if (window.Toast) {
          Toast.warn(d.note || `${f.name} 读不出内容`);
        }
      } catch (e) {
        chip.textContent = `❌ ${f.name}`;
        chip.title = String(e.message || e);
        if (window.Toast) Toast.error(`${f.name} 上传失败：${e.message || e}`);
      }
    }
  },

  clearAttachments() {
    this.attachments = [];
    this.images = [];
    const bar = document.getElementById('chatAttachBar');
    if (bar) { bar.innerHTML = ''; bar.hidden = true; }
  },

  /** 把附件正文拼在用户消息**前面**（先给资料、再说要求 —— 模型读起来更顺） */
  withAttachments(content) {
    if (!this.attachments || !this.attachments.length) return content;
    const blocks = this.attachments.map(a => a.block).filter(Boolean).join('\n\n');
    const said = (content && content.trim()) ? content.trim() : '（请看我上传的附件）';
    return (blocks ? blocks + '\n\n' : '') + said;
  },

  async sendMessage(content) {
    // ★ 附件：把抽出来的正文并进这条消息（界面上显示的仍是用户自己那句话）
    content = this.withAttachments(content);
    if (!content.trim() || this.streaming) return;
    // ★★★ 2026-09-29（真跑前端的测试抓到的 bug —— 拖进去的图**根本发不出去**）
    //
    //   我上一轮给 `clearAttachments()` 加了"顺便清空 this.images"，
    //   而这一行 `clearAttachments()` 在**组装请求体之前**执行 ——
    //   于是 `body.images` 永远是空数组：用户拖了图、界面也显示了缩略图，
    //   但后端**一张都收不到**（表现就是"拖进去它当没看见"）。
    //
    //   所以图片路径必须和附件正文一样，**先取下来再清**。
    const imagePaths = (this.images || []).map(x => x.path).filter(Boolean);
    this.clearAttachments();

    // 首次消息时新建会话
    if (!this.currentConvId) {
      this.newConversation();
    }

    // 关闭欢迎区
    document.getElementById('chatWelcome').style.display = 'none';

    // 添加用户消息
    const userMsg = {
      role: 'user',
      content: content.trim(),
      timestamp: new Date().toISOString(),
    };
    this.messages.push(userMsg);
    this.appendMessage(userMsg);

    // 准备 AI 消息占位
    const aiMsg = {
      role: 'assistant',
      content: '',
      timestamp: new Date().toISOString(),
      streaming: true,
    };
    this.messages.push(aiMsg);
    const aiEl = this.appendMessage(aiMsg);

    // 自动生成会话标题（用第一条用户消息）。
    // ⚠ 旧判断是 `messages.length === 1`，但此处数组里已经有「用户 + AI」两条
    //   → 条件永远不成立 → 所有会话都叫「新会话」，根本分不清。
    const conv = this.conversations.find(c => c.id === this.currentConvId);
    if (conv && (!conv.title || conv.title === '新会话' || conv.title.trim() === '')) {
      const firstUser = (this.messages.find(m => m.role === 'user') || {}).content || content || '';
      const t = String(firstUser).replace(/\s+/g, ' ').trim().slice(0, 18);
      if (t) {
        conv.title = t;
        this.saveConversations();
        this.renderConversations();
      }
    }

    this.streaming = true;
    const sendBtn = document.getElementById('sendChatBtn');
    sendBtn.disabled = true;

    try {
      const messages = this.messages
        .filter(m => !m.streaming)
        .map(m => ({ role: m.role, content: m.content }));

      const body = {
        provider: this.currentProvider,
        model: this.currentModel,
        api_key: this.currentApiKey,
        messages,
        stream: true,
        temperature: 0.7,
        // ★ agent 模式：后端会走工具循环，模型能直接操作平台。
        //   工作区里已经没有生成按钮了，所有生成动作都从这里出去。
        agent: true,
        // 当前项目 id 注入 system prompt —— 模型就不用先调 list_projects 去猜
        project_id: (window.State && State.currentProject && State.currentProject.id) || null,
        // ★★ 2026-09-29（用户第 1 条）：「支持图片理解」——
        //   把上传图片的**本机路径**带上，后端会拼成图像块让模型**真的看图**
        //   （实测它能准确描述画面，不是只报尺寸）。
        //   ⚠ 用上面**提前取好的** imagePaths，不要在这里读 this.images ——
        //     那时它已经被 clearAttachments() 清空了（真跑测试抓到过）。
        images: imagePaths,
        max_steps: 12,
      };

      const response = await fetch('/api/chat/stream', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });

      if (!response.ok) {
        const err = await response.json().catch(() => ({}));
        throw new Error(err.detail?.message || `HTTP ${response.status}`);
      }

      const reader = response.body.getReader();
      const decoder = new TextDecoder();
      let buffer = '';

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });

        const lines = buffer.split('\n');
        buffer = lines.pop(); // 剩余的不完整行

        for (const line of lines) {
          if (!line.startsWith('data:')) continue;
          const payload = line.slice(5).trim();
          if (payload === '[DONE]') {
            aiMsg.streaming = false;
            this.streaming = false;
            sendBtn.disabled = false;
            this.saveCurrentConv();
            return;
          }
          try {
            const data = JSON.parse(payload);
            if (data.error) {
              throw new Error(data.error);
            }
            // ── Agent 执行轨迹 ──
            // 工作区里已经没有生成按钮了，用户唯一能看到"AI 正在干什么"的地方
            // 就是这里。不画出来的话，一个要跑几分钟的生成任务看起来就跟卡死一样。
            if (data.step) {
              this.pushTrace(aiMsg, aiEl, {
                kind: 'step', tool: data.step.tool, args: data.step.args,
                index: data.step.index,
              });
            }
            if (data.result) {
              this.pushTrace(aiMsg, aiEl, {
                kind: 'result', ok: !!data.result.ok,
                data: data.result.data, index: data.result.index,
              });
            }
            if (data.delta) {
              aiMsg.content += data.delta;
              this.updateAIMessage(aiEl, aiMsg.content);
              this.scrollToBottom();
            }
          } catch (e) {
            if (e.message && !e.message.includes('JSON')) throw e;
          }
        }
      }
    } catch (e) {
      aiMsg.content += `\n\n[错误] ${e.message}`;
      aiMsg.streaming = false;
      aiMsg.error = true;
      this.updateAIMessage(aiEl, aiMsg.content);
      Toast.error(e.message);
    } finally {
      this.streaming = false;
      sendBtn.disabled = false;
      this.saveCurrentConv();
    }
  },

  // ──────────── Agent 执行轨迹 ────────────
  //
  // 为什么必须画出来：工作区里的生成按钮全拿掉了，用户唯一的进度反馈就是这块。
  // 一个 agent 轮次可能跑 8 步、每步几十秒（真调视频模型）。不显示的话，
  // 界面上就是"发了一句话，然后一直转圈"，用户只能猜是不是卡死了。
  //
  // 说明文案用中文短句而不是工具名 —— "list_projects" 对做短剧的人没有意义。

  TOOL_LABELS: {
    list_projects:        '看你的项目列表',
    create_project:       '新建项目',
    get_project_status:   '查项目进度',
    list_assets:          '翻你的角色/场景资产',
    list_video_models:    '查可用的视频模型',
    import_script:        '导入剧本',
    generate_script:      '写剧本',
    extract_assets:       '从剧本里提取角色/场景',
    plan_shots:           '拆分镜头',
    preview_mentions:     '检查 @角色/@场景 引用',
    plan_long_video:      '排片（免费，先算清楚切几段）',
    render_previz:        '渲白膜（本地免费）',
    review_previz:        '记录你的确认/驳回',
    generate_preview:     '出 480P 草稿样片（便宜）',
    generate_final:       '出 1080P 成片（贵）',
    get_shot_progress:    '查这个镜头做到哪了',
    // 可灵官方 MCP（免 API key）那一批
    check_kling_mcp:      '查可灵通道状态',
    kling_mcp_auth:       '开始可灵授权（不用 key）',
    kling_mcp_finish_auth: '收尾可灵授权',
    list_kling_mcp_tools: '列可灵能用的工具',
    kling_status:         '查可灵额度与可用模型',
    kling_upload:         '把本地文件传给可灵',
    kling_element:        '把这个角色注册成可灵主体',
    kling_elements:       '看可灵里已注册的主体',
    kling_generate:       '用可灵生成（花灵感值）',
    kling_white_model:    '白膜 → 正式镜头（可灵动作控制）',
    kling_task:           '查可灵生成进度',
    local_image_service:  '本机出图服务（状态/重启）',
    // 流水线闸门（一步步走：提案 → 用户确认 → 执行）
    pipeline_status:      '查制作进度（走到哪一步了）',
    propose_step:         '准备下一步（还没开始做，等你点头）',
    confirm_step:         '执行你确认过的那一步',
    revise_step:          '按你说的改这一步的参数',
    skip_step:            '跳过这一步',
    // 出图（定妆照 / 场景图）
    make_character_look:  '给角色出定妆照',
    make_scene_look:      '给场景出概念图',
    make_looks:           '批量补齐定妆照/场景图',
    refine_look:          '按你的指令改这张图（其余不动）',
  },

  toolLabel(name) {
    return this.TOOL_LABELS[name] || name;
  },

  pushTrace(aiMsg, aiEl, ev) {
    if (!aiEl) return;
    let box = aiEl.querySelector('.agent-trace');
    if (!box) {
      box = document.createElement('div');
      box.className = 'agent-trace';
      const body = aiEl.querySelector('.msg-body');
      (body || aiEl).insertBefore(box, (body || aiEl).querySelector('.msg-content'));
    }

    if (ev.kind === 'step') {
      const row = document.createElement('div');
      row.className = 'agent-step';
      row.dataset.index = String(ev.index || '');
      // 记住工具名：result 事件本身不带工具名，后面要靠它决定怎么渲染结果
      row.dataset.tool = ev.tool || '';
      // ★ 顺手记住这一步的 project_id（参数里基本都有，用户在气泡里也看得到）。
      //   为什么要留一份：result 里**不一定**回带 project_id（例如 import_script、
      //   pipeline_status、propose_step 的返回就没有），而确认按钮要用它。
      //   留在 DOM 上，confirmGate 就能在"界面没点过项目"时把它捡回来。
      row.dataset.pid = String((ev.args && ev.args.project_id) || '');
      const args = ev.args && Object.keys(ev.args).length
        ? ' ' + escapeHtml(JSON.stringify(ev.args))
        : '';
      row.innerHTML =
        `<span class="agent-spin"></span>` +
        `<span class="agent-step-text">正在${escapeHtml(this.toolLabel(ev.tool))}…</span>` +
        `<span class="agent-elapsed" data-t0="${Date.now()}">0 秒</span>` +
        `<code class="agent-step-tool">${escapeHtml(ev.tool)}${args}</code>`;
      // ★★ 2026-09-27 第 46 轮（用户第 7 条）：**等待要有进度感**。
      //   本机出图实测 144~265 秒、视频生成更久；原来界面上只有一个转圈 +
      //   一句"正在…"，跑 4 分钟一点变化都没有 —— 用户原话「干等会很尴尬」。
      //   这里给每一步挂一个**秒表**（每秒刷新），并按工具给出"大概要多久"，
      //   让人知道它在动、还要多久。
      const _t = String(ev.tool || '');
      const _hint = /^(make_character_look|make_scene_look|make_looks|refine_look)$/.test(_t)
        ? '本机出图，一张大约 2~4 分钟'
        : (/^(kling_generate|kling_white_model|generate_preview|generate_final)$/.test(_t)
           ? '视频生成，通常 1~5 分钟' : '');
      if (_hint) {
        const h = document.createElement('span');
        h.className = 'agent-hint';
        h.textContent = '（' + _hint + '）';
        row.appendChild(h);
      }
      box.appendChild(row);
      this.startElapsedTimer(row);
    } else if (ev.kind === 'result') {
      // 找到同一 index 的那一行（找不到就直接追加，宁可多显示也不要丢信息）
      let row = box.querySelector(`.agent-step[data-index="${ev.index}"]`);
      if (!row) {
        row = document.createElement('div');
        row.className = 'agent-step';
        box.appendChild(row);
      }
      this.stopElapsedTimer(row);
      const spin = row.querySelector('.agent-spin');
      if (spin) {
        spin.className = ev.ok ? 'agent-ok' : 'agent-fail';
        spin.textContent = ev.ok ? '✓' : '✗';
      }
      const d = ev.data || {};
      const toolName = row.dataset.tool || '';
      let extra = '';
      try {
        if (!ev.ok) {
          // 失败必须把原因原文摆出来 —— 这是用户唯一能判断"是缺 Key 还是模型拒了"的地方
          // ★★ 2026-09-28 第 74 轮例外：**参数校验类**的失败（`internal: true`）
          //   是给**模型**看的技术说明，不是给用户的。用户截图里就出现过
          //   「`draft_task_id` 要的是真实 id，但收到的是「生成的草稿任务 ID（如果适用）」」
          //   —— 用户的原话是「视频生成有bug」「用户看代码干嘛？」。
          //   这类错误只显示一句人话；技术原文留在控制台（排查时能拿到）。
          if (d.internal) {
            console.warn('[chat] 工具参数校验失败（技术原文不展示给用户）：', d.error);
            extra = `<div class="agent-err">${escapeHtml(String(
              d.say_to_user || '这一步需要先补齐必要信息，我换个方式再来。'))}</div>`;
          } else {
            extra = `<div class="agent-err">${escapeHtml(String(d.error || '执行失败'))}</div>`;
          }
        } else {
          extra = this.renderResultDetail(toolName, d);
        }
      } catch (e) {
        // ★ 渲染失败绝不能把整轮对话打断。
        //   实测踩过：一个未定义变量（frame_urls）让 render_previz 的结果
        //   渲染时抛 ReferenceError，异常冒到 SSE 循环里，整轮 agent 回复
        //   变成 "[错误] frame_urls is not defined" —— 用户看到的是"AI 坏了"，
        //   而真实原因是**显示层**写错了一个变量名。结果里的数据其实是好的。
        //   所以：渲染出错就退化成纯文本，把原始数据留在控制台。
        console.error('[chat] 渲染工具结果失败：', toolName, e);
        extra = `<div class="agent-err">结果渲染出错（数据本身是好的）：${escapeHtml(String(e.message || e))}</div>`;
      }
      // ★★ 2026-09-27 第 71 轮：写资产/分镜的工具成功后，**通知资产页重取数据**。
      //   用户实测原话：「我手动删了资产后让对话重加还是看不到我要的资产」。
      //   原因是：他已经站在「资产」页上，而对话在**另一个 section**里跑 ——
      //   页面不切走就永远不会重新请求，于是"AI 说加好了、界面上还是空的"。
      //   这里只在成功时派事件，页面自己不重取也不会出错（监听方按需重取）。
      if (ev.ok && _ASSET_WRITING_TOOLS.has(toolName)) {
        try {
          window.dispatchEvent(new CustomEvent('vf:assets-changed',
            { detail: { tool: toolName } }));
        } catch (e) { /* 老浏览器忽略 */ }
      }
      if (extra) {
        row.insertAdjacentHTML('beforeend', extra);
        // 同一条回复里同一个阶段只留最后一张卡片（见 dedupeGateCards）
        this.dedupeGateCards(aiEl);
      }

      // ★★ 对话里新建/切换了项目 → 让界面也跟过去。
      //
      // 为什么必须做（实测卡死过）：待确认卡片上的「✅ 确认」按钮要用
      // `State.currentProject.id` 才知道对哪个项目执行。而 `State.currentProject`
      // 只在用户**点项目列表**时才赋值 —— 用户在对话里说「做一个新短片」，
      // agent 调 create_project 建好了、卡片也出来了，但界面的"当前项目"
      // 还是空的（或者还是上一个）。这时点「确认」只会弹一句
      // 「先选一个项目」，用户完全不知道为什么。
      //
      // 对话的上下文本来就该驱动界面上下文：agent 刚在哪个项目上干活，
      // 那个项目就是"当前项目"。所以这里从工具结果里认出来并选中它。
      if (ev.ok && d && typeof d === 'object') {
        const pidFromTool = d.project_id || row.dataset.pid
          || (toolName === 'create_project' ? d.id : '');
        if (pidFromTool && String(pidFromTool) !== String(this.currentProjectId())) {
          // 见 syncCurrentProject 的说明：这里**不允许**静默什么都不做
          this.syncCurrentProject(pidFromTool)
            .catch(err => console.warn('[chat] 自动切换当前项目失败：', err));
        }
      }

      // 每一步的结果也记进消息对象，这样存进会话后重新打开还看得到。
      // ★ 必须连 data 一起存：只存 {tool, ok} 的话，重开会话就只剩一串 ✓，
      //   所有产物（白膜帧、定妆照、成片）和它们的「下载 / 存资产库」按钮全没了。
      if (!aiMsg.steps) aiMsg.steps = [];
      aiMsg.steps.push({ tool: toolName, ok: ev.ok, data: this._slimForHistory(d) });
      row.dataset.stored = '1';
    }
    this.scrollToBottom();
  },

  /**
   * 存历史前把结果瘦身：URL 数组只留前几个、长字符串截断。
   * 会话是存在 localStorage / 数据库里的，不能因为一轮出了 20 张图就把它撑爆。
   */
  _slimForHistory(d, depth) {
    depth = depth || 0;
    if (d === null || d === undefined) return d;
    if (typeof d === 'string') return d.length > 600 ? d.slice(0, 600) + '…' : d;
    if (typeof d !== 'object') return d;
    if (depth > 3) return undefined;
    if (Array.isArray(d)) return d.slice(0, 12).map(x => this._slimForHistory(x, depth + 1));
    const out = {};
    Object.keys(d).forEach(k => {
      // prompt / 原始日志这类大字段对"重新显示"没用，丢掉
      if (/^(prompt|raw|trace|logs?|stdout|stderr|html)$/i.test(k)) return;
      const v = this._slimForHistory(d[k], depth + 1);
      if (v !== undefined) out[k] = v;
    });
    return out;
  },

  // 把工具结果渲染成人能看懂的东西。
  // ★ 为什么非做不可：白膜（previz）的价值**全在画面**上 ——
  //   把 render_previz 的结果只显示成一行 "OK"，用户根本没法确认运镜对不对，
  //   整条"先白膜后成片"的流程就白设了。所以帧图必须画出来。
  renderResultDetail(tool, d) {
    const esc = escapeHtml;
    const bits = [];

    // ── ★ 待确认卡片（一步一步走的核心）──
    // 两种来源都要出卡片，缺一不可：
    //   ① propose_step / revise_step 返回 await_confirm → 有正式提案
    //   ② pipeline_status 返回 next（下一步该做什么）→ 没有正式提案
    // ★ 为什么必须有 ②：实测发现模型经常**只在回复文字里描述提案**，
    //   却没真去调 propose_step。这时界面上没有卡片，用户打「确认」
    //   就撞上"没有待确认的提案"，直接卡死且不知道为什么。
    //   有了 ②，用户永远有一个能点的按钮 —— 而"用户点了确认"本身就是同意
    //   （后端 /stage/confirm 支持无提案直接推进当前这一步）。
    if (d && d.await_confirm && d.stage) {
      bits.push(this.renderGateCard(d));
    } else if (d && d.next && d.next.gate && !d.pending_gate) {
      const n = d.next;
      bits.push(this.renderGateCard({
        stage: n.key, title: n.title, why: n.why,
        cost_label: n.cost_label, eta: n.eta, tweaks: n.tweaks,
        doing: n.doing || '',
        note: '（这张卡片直接来自进度查询，点「确认」就会做这一步）',
      }));
    }

    // ── 白膜：多机位图 + 帧图 + 视频 + 确认按钮 ──
    const frames = d.frame_urls || d.frames || [];
    const views = d.view_urls || [];
    const clips = d.camera_clips || [];
    if (tool === 'render_previz' && d.rendered && clips.length) {
      // C 档：多机位**视频**。每个机位一段，外加一条覆盖片。
      // 为什么这样排：用户要做的决定是"这场戏用哪个机位"，
      // 所以先把覆盖片放最上面（点一次看全），下面再列单机位供细看。
      const clipHtml = clips.map(c => `
        <div class="agent-clip">
          <div class="agent-clip-head">${esc(c.label || c.name)}
            <span class="dim">${esc(c.name)}</span></div>
          <video src="${esc(c.url)}" controls preload="metadata"></video>
          <div class="agent-previz-actions">
            ${this.mediaActions(c.url, { filename: `白膜_${c.name || '机位'}.mp4`,
                                        saveLabel: '存为资产', savable: false })}
          </div>
        </div>`).join('');
      const shotId = d.shot_id || '';
      bits.push(`
        <div class="agent-previz agent-previz-c">
          <div class="agent-previz-head">🎬 白膜 C 档 · 多机位视频 · <b>免费</b>
            <span class="dim">${d.duration_seconds ? d.duration_seconds.toFixed(1) + ' 秒' : ''}
              · ${clips.length} 个机位</span></div>
          ${d.coverage_cut ? `
            <div class="agent-clip agent-clip-cut">
              <div class="agent-clip-head">覆盖片 —— 一条看完所有机位</div>
              <video src="${esc(d.coverage_cut)}" controls preload="metadata"></video>
              <div class="agent-previz-actions">
                ${this.mediaActions(d.coverage_cut, { filename: '白膜_覆盖片.mp4',
                                                      savable: false })}
              </div>
            </div>` : ''}
          ${d.coverage_sheet_url ? `
            <a href="${esc(d.coverage_sheet_url)}" target="_blank" title="点开看大图">
              <img class="agent-view" src="${esc(d.coverage_sheet_url)}"
                   alt="各机位首帧联络表" loading="lazy">
            </a>
            <div class="agent-previz-actions">
              ${this.mediaActions(d.coverage_sheet_url,
                                  { filename: '白膜_机位联络表.png',
                                    saveLabel: '存为场景图' })}
            </div>` : ''}
          <div class="agent-views-clips">${clipHtml}</div>
          <div class="agent-previz-hint">
            挑一个机位用 —— 有真透视和前后遮挡，能看到<b>运动过程里谁挡住了谁</b>。
            <b>这一步不花钱，可以无限重来。</b>
          </div>
          ${shotId ? `<div class="agent-previz-actions">
            <button class="secondary-btn agent-ok-btn"
                    data-shot="${esc(shotId)}" data-act="approve">✅ 就这样，去生成</button>
            <button class="secondary-btn agent-no-btn"
                    data-shot="${esc(shotId)}" data-act="reject">✏️ 不行，要改</button>
          </div>` : ''}
          ${this.renderPrevizConstraint(d.can_constrain_generation)}
        </div>`);
    } else if (tool === 'render_previz' && d.rendered && (frames.length || views.length)) {
      const imgs = frames.slice(0, 3).map((u, i) =>
        `<a href="${esc(u)}" target="_blank" title="点开看大图">
           <img class="agent-frame" src="${esc(u)}" alt="白膜第 ${i + 1} 帧" loading="lazy">
         </a>`).join('');
      // B 档：多机位联络表。A 档的平面帧看不出"人会不会撞到桌子、
      // 柱子会不会挡住主角" —— 而这两个错误最贵（生成出来才发现就白抽了）。
      const viewImgs = views.map((u, i) =>
        `<a href="${esc(u)}" target="_blank" title="点开看大图">
           <img class="agent-view" src="${esc(u)}" alt="多机位白膜 ${i + 1}" loading="lazy">
         </a>`).join('');      const shotId = d.shot_id || '';
      const tier = d.tier || 'A';
      const sl = d.spatial_lint || null;
      bits.push(`
        <div class="agent-previz">
          <div class="agent-previz-head">🎬 白膜预演 · 本地渲染 · <b>免费</b>
            <span class="dim">${d.duration_seconds ? d.duration_seconds.toFixed(1) + ' 秒' : ''}
              ${tier === 'B' ? '· B 档多机位' : '· A 档平面'}</span>
          </div>
          ${viewImgs ? `<div class="agent-views">${viewImgs}</div>
            <div class="agent-previz-hint">多机位图（俯视 / 正面 / 侧面）：
              <b>看走位会不会撞、前景会不会挡住主角</b> —— 这两件事平面帧看不出来。</div>
            <div class="agent-previz-actions">
              ${this.mediaActions(views[0], { filename: '白膜_多机位.png',
                                              saveLabel: '存为场景图' })}
            </div>` : ''}
          <div class="agent-frames">${imgs}</div>
          <div class="agent-previz-hint">
            看一眼运镜 / 走位 / 节奏对不对。<b>这一步不花钱，不满意可以无限重来。</b>
          </div>
          ${shotId ? `<div class="agent-previz-actions">
            <button class="secondary-btn agent-ok-btn"
                    data-shot="${esc(shotId)}" data-act="approve">✅ 就这样，去生成</button>
            <button class="secondary-btn agent-no-btn"
                    data-shot="${esc(shotId)}" data-act="reject">✏️ 不行，要改</button>
            ${frames.length ? this.mediaActions(frames[0],
                { filename: '白膜首帧.png', saveLabel: '存为场景图' }) : ''}
          </div>` : ''}
          ${d.video_url ? `<div class="agent-previz-video">
            <video src="${esc(d.video_url)}" controls preload="metadata"></video>
            <div class="agent-previz-actions">
              ${this.dlBtn(d.video_url, '白膜.mp4', '下载白膜视频')}
            </div>
          </div>` : ''}
          ${sl && !sl.ok ? `<div class="agent-err">三维体检：${esc(String((sl.errors || [])[0] || '').slice(0, 170))}</div>` : ''}
          ${this.renderPrevizConstraint(d.can_constrain_generation)}
        </div>`);
    } else if (tool === 'kling_status' || tool === 'kling_generate'
               || tool === 'kling_white_model' || tool === 'kling_upload'
               || tool === 'kling_element' || tool === 'kling_elements'
               || tool === 'kling_task') {
      // ── 可灵官方 MCP（免 API key）──
      // 为什么不复用通用渲染：可灵这条路上有两件**必须让用户看见**的事
      //   ① 灵感值余额 —— 为 0 的时候再点生成就是白试一次
      //   ② 成品 URL 24 小时后过期 —— 不提醒就等于没做出东西
      const cr = (d.credits && typeof d.credits === 'object') ? d.credits : null;
      const num = (v) => (v === null || v === undefined || v === '') ? '?' : v;

      if (tool === 'kling_status') {
        const usable = d.usable === true;
        bits.push(`
          <div class="agent-kling">
            <div class="agent-previz-head">🎬 可灵官方通道 · <b>不用 API key</b>
              <span class="dim">OAuth 授权一次，之后自动续期</span></div>
            <div class="agent-kling-rows">
              <span>会员：<b>${esc(String(num(cr && cr.membership)))}</b></span>
              <span class="${cr && cr.enough ? 'agent-ok-t' : 'agent-bad-t'}">
                灵感值：<b>${esc(String(num(cr && cr.credits)))}</b></span>
              ${d.mcp_version ? `<span class="dim">MCP ${esc(String(d.mcp_version))}</span>` : ''}
            </div>
            ${!usable && cr && !cr.enough ? `
              <div class="agent-warn">⚠ 灵感值为 0，现在提交生成一定会被平台拒。
                要充值请点下面这个链接（充值后回来说一声「继续」即可）。</div>
              <div class="agent-previz-actions">
                <a class="primary-btn" target="_blank" rel="noopener"
                   href="${esc(cr.topup_url || 'https://klingai.com/h5-app/membership-agent?r=agent_VideoForge')}">
                  去可灵充值</a>
              </div>` : ''}
            ${(d.notes || []).map(n => `<div class="agent-note-line">${esc(String(n))}</div>`).join('')}
          </div>`);
      }

      const urls = d.urls || [];
      if (urls.length) {
        const isVideo = /\.mp4(\?|$)/i.test(String(urls[0])) || tool === 'kling_generate'
          || tool === 'kling_white_model';
        bits.push(`
          <div class="agent-kling-out">
            ${isVideo
              ? `<video src="${esc(urls[0])}" controls preload="metadata"></video>`
              : `<img src="${esc(urls[0])}" alt="可灵产物" loading="lazy">`}
            <div class="agent-previz-actions">
              ${this.dlBtn(urls[0], (isVideo ? '可灵成品.mp4' : '可灵成品.png'),
                           isVideo ? '下载这段视频' : '下载这张图')}
              ${!isVideo ? this.saveAssetBtn(urls[0], '存为角色形象/场景图') : ''}
              ${urls.slice(1).map((u, i) =>
                `<a class="secondary-btn" href="${esc(u)}" target="_blank"
                    rel="noopener">第 ${i + 2} 个</a>`).join('')}
            </div>
            <div class="agent-warn">⏳ 可灵的成品链接 <b>24 小时后过期</b>，
              请及时下载保存 —— 或者点「存为角色形象/场景图」存进资产库，那样就永久留在本机了。</div>
          </div>`);
        if (d.elapsed) bits.push(`耗时 ${d.elapsed} 秒`);
        if (d.status) bits.push(`状态 ${esc(String(d.status))}`);
      } else if (tool === 'kling_upload' && d.url) {
        bits.push(`已上传，得到可用的 URL（白膜/定妆照都不需要公网隧道了）`);
      } else if (tool === 'kling_element' && d.element_id) {
        bits.push(`主体已注册：<b>${esc(String(d.character || ''))}</b>
          <span class="dim">element_id = ${esc(String(d.element_id))}</span>`);
      } else if (tool === 'kling_elements') {
        bits.push(`账号里已有 ${num(d.count)} 个可复用主体`);
      } else if (d.generation_id) {
        bits.push(`已提交，任务 id <span class="dim">${esc(String(d.generation_id))}</span>
          —— 用「查可灵生成进度」看结果`);
      }
    } else if (d.counts || d.segment_count || d.segments || d.rendered !== undefined) {
      if (d.counts) bits.push(`场景 ${d.counts.scenes ?? '-'} / 镜头 ${d.counts.shots ?? '-'} / 角色 ${d.counts.characters ?? '-'}`);
      if (d.segment_count) bits.push(`分 ${d.segment_count} 段`);
      if (d.reused) bits.push(`复用 ${d.reused} 段`);
      if (d.rendered !== undefined && tool !== 'render_previz') bits.push(d.rendered ? '白膜已渲好' : '白膜没渲出来');
      if (d.next_step) bits.push(String(d.next_step).slice(0, 120));
    }

    // ── 通用媒体渲染（兜底，但很关键）──
    // ★ 为什么必须有这一段：上面整条 if/else 链是**按工具名**硬编码的，
    //   只有 render_previz 和 kling_* 这两个分支会画图。
    //   结果是后来新增/已存在的出图工具（make_looks / make_character_look /
    //   make_scene_look / refine_look …）返回的图**一张都不显示**，
    //   用户只能看到一行 ✓ —— 明明出了图，却像什么都没发生。
    //   这里改成按**载荷形状**兜底：只要结果里带图片/视频，就画出来，
    //   并且每个都配上「下载」和「存资产库」。以后再加工具也不用改这里。
    const gm = this.renderGenericMedia(tool, d);
    if (gm) bits.push(gm);

    // 别的工具给一句 next_step 摘要就够
    if (!bits.length && d.next_step) bits.push(String(d.next_step).slice(0, 120));

    // 白膜的 lint 警告也要露出来（朝向没标、参考图比例不一致这类）
    const warns = d.lint_warnings || [];
    if (warns.length) {
      bits.push(`<div class="agent-warn">⚠ ${esc(String(warns[0]).slice(0, 160))}${warns.length > 1 ? `（还有 ${warns.length - 1} 条）` : ''}</div>`);
    }
    const errs = d.lint_errors || [];
    if (errs.length) {
      bits.push(`<div class="agent-err">${esc(String(errs[0]).slice(0, 200))}</div>`);
    }

    // ★★ 三级链路 + 花钱实话（2026-09-27 第 70 轮）。
    //   用户要求「做到我能用好」—— 那 agent 每次动这一镜时，
    //   对话里就得顺手把"在哪一档 / 下一档花多少 / 模型有没有便宜那一档"说清。
    //   尤其是 `money_warning`：实测这台模型不接受 draft 参数，
    //   "低价草稿→高档成片"那条省钱路线**根本不存在**，
    //   不说出来用户会一直以为自己省了钱。
    if (d.tiers && d.tiers.G1 && typeof this.renderTierStrip === 'function') {
      bits.push(this.renderTierStrip(d.tiers));
    }
    if (d.money_warning) {
      bits.push(`<div class="agent-warn">${esc(String(d.money_warning))}</div>`);
    }

    return bits.length ? `<div class="agent-note">${bits.join(' · ')}</div>`.replace(' · <div', '<div') : '';
  },

  /** 三级链路状态条（与资产页同一个画法，避免两处说法不一致）。 */
  renderTierStrip(T) {
    if (!T || !T.G1) return '';
    const ORDER = [['G1', '白膜'], ['G2', '草稿'], ['G3', '成片']];
    const ICON = { done: '✓', waiting_confirm: '待确认', todo: '○', unavailable: '✕' };
    const chips = ORDER.map(([k, label]) => {
      const t = T[k] || {};
      const st = t.state || 'todo';
      const tip = [t.name, t.cost ? `花费：${t.cost}` : '', t.detail || '',
                   t.cost_note ? `（${t.cost_note}）` : ''].filter(Boolean).join('\n');
      return `<span class="tier-chip ${st}" title="${esc(tip)}">${k} ${label} <b>${ICON[st] || st}</b>` +
             (t.cost ? `<i class="tier-cost">${esc(t.cost)}</i>` : '') + `</span>`;
    }).join('<span class="tier-arrow">→</span>');
    const NXT = { render_previz: '渲白膜（免费）', review_previz: '确认白膜',
                  generate_preview: '出草稿样片', generate_final: '出成片',
                  compose_film: '配音 + 拼成片' };
    const nxt = NXT[T.next_action] || '';
    return `<div class="tier-strip">${chips}` +
           (nxt ? `<span class="tier-next" title="${esc(T.next_why || '')}">下一步：${esc(nxt)}</span>` : '') +
           `</div>`;
  },

  // ──────────────── 当前项目：两个"看起来一定有"的全局 ────────────────
  // ★★ 为什么要有这三个小函数（2026-09-26 用户在真实使用里**卡死**过一次）：
  //   待确认卡片上的「✅ 确认」要用**当前项目 id**。而这条链上有两个
  //   "看起来一定有、其实不一定"的全局：
  //     ① `State` 到底是 `const State = {...}`（**词法绑定，不在 `window` 上**）
  //        还是 `window.State = {...}`？—— 原来一律写成 `window.State && ...`：
  //        如果它是词法绑定，这个判断**恒为假** ⇒ 永远取到空 id ⇒
  //        点「确认」只弹一句"还没确定当前项目"，而且**不报任何错**。
  //     ② `selectProject` 是否挂在全局、签名是不是 `(id, {navigate})`。
  //   任何一环拿不到，旧代码就**静默什么都不做**。用户看到的是：
  //   卡片出来了、点确认却说没确定当前项目，还让他去点一个**已经从界面移除**的
  //   "左侧项目列表" —— 一条走不通的死路。
  //   ⇒ 所以：两种形态都认，并且**始终兜底把 id 写进状态**。

  stateRef() {
    try {
      if (typeof State !== 'undefined' && State) return State;   // 词法绑定形态
    } catch (e) { /* 完全没声明 */ }
    return (typeof window !== 'undefined' && window.State) || null;
  },

  currentProjectId() {
    const s = this.stateRef();
    return (s && s.currentProject && s.currentProject.id) || '';
  },

  /** 认下"当前项目"：能用 selectProject 就用（它会同步整个界面），
   *  然后**无论如何**保证 `currentProject.id` 已写上 —— 确认按钮只认这个。
   *  ★ 不允许"静默什么都不做"：拿不到 selectProject 就自己写状态 + 广播事件。 */
  syncCurrentProject(pid) {
    if (!pid) return Promise.resolve();
    const self = this;
    const ensure = () => {
      const s = self.stateRef();
      if (s) {
        s.currentProject = Object.assign({}, (s.currentProject || {}), { id: String(pid) });
      }
      try {
        window.dispatchEvent(new CustomEvent('vf:current-project', { detail: String(pid) }));
      } catch (e) { /* 广播失败不影响主流程 */ }
    };
    let p = Promise.resolve();
    try {
      if (typeof selectProject === 'function') {
        p = Promise.resolve(selectProject(String(pid), { navigate: false }))
          .catch(err => { console.warn('[chat] selectProject 失败，改用直接写状态：', err); });
      } else {
        console.warn('[chat] 没有全局 selectProject —— 直接写当前项目状态：', pid);
      }
    } catch (err) {
      console.warn('[chat] selectProject 抛异常，改用直接写状态：', err);
    }
    return p.then(ensure);
  },

  // ──────────────────────── 待确认卡片 ────────────────────────
  // 「一步步走完、每步等你点头」在界面上的样子。
  // 用户点「✅ 确认」时走 **HTTP 直连**（/stage/confirm），不经过 LLM：
  //   实测过用对话"确认"两个字让模型去调 confirm_step，模型有时会理解偏、
  //   有时会顺手多调一个工具。按钮必须做到"点了就一定执行、不执行就一定报错"。

  /** 同一条回复里，**同一个阶段只留最后一张**待确认卡片。
   *  ★ 为什么（用户实测反馈：同一步出现了两个"下一步"）：
   *    `pipeline_status` 会先给一张"来自进度查询"的卡片（它存在的理由见
   *    `renderResultDetail` 的注释：模型经常只在文字里描述提案、界面上没有
   *    可点的按钮），紧接着 `propose_step` 又给一张**正式提案**卡片。
   *    两张都带「✅ 确认」，用户不知道该点哪张 —— 屏幕上同时出现两个"下一步"，
   *    看起来像系统出错了。
   *  ★ 保留**最后**一张：后出现的是正式提案，带着真实参数；先出现那张只是
   *    进度查询的副产物。不同阶段（先跳过后又提别的）互不影响。 */
  dedupeGateCards(aiEl) {
    if (!aiEl) return;
    const box = aiEl.querySelector('.agent-trace');
    if (!box) return;
    const byStage = {};
    const order = [];
    box.querySelectorAll('.agent-gate').forEach(c => {
      const st = c.getAttribute('data-gate-stage') || '';
      if (!byStage[st]) { byStage[st] = []; order.push(st); }
      byStage[st].push(c);
    });
    order.forEach(st => {
      const list = byStage[st];
      for (let i = 0; i < list.length - 1; i++) {
        try { list[i].remove(); } catch (e) { /* 已经不在 DOM 里就算了 */ }
      }
    });
  },

  renderGateCard(d) {
    const esc = escapeHtml;
    const tweaks = (d.tweaks || []).map(t =>
      `<button class="gate-tweak" data-vf-gate-tweak="${esc(t)}">${esc(t)}</button>`).join('');
    const warn = d.warning
      ? `<div class="gate-warn">⚠ ${esc(String(d.warning))}</div>` : '';
    const already = d.already_done
      ? `<div class="gate-warn">ℹ 这一步看起来已经做过了：${esc(String(d.done_detail || ''))}。
          再跑一次会覆盖/重复，确认前想清楚。</div>` : '';
    // ★ 2026-09-28（用户第 1、2、7 条）：把"还缺什么"直接写在卡上。
    //   实测死循环：4 张角色卡没图 ⇒ 定妆这一步永远做不完 ⇒ 模型每次都问一遍
    //   （用户体验成「重复问用户定妆」）。列出来，用户就知道点确认会发生什么。
    const _na = d.needs_attention || {};
    const _naBits = [];
    if ((_na.characters_without_image || []).length) {
      _naBits.push(`角色定妆照 <b>${_na.characters_without_image.length}</b> 张还没出：`
        + esc(_na.characters_without_image.slice(0, 8).join('、')));
    }
    if ((_na.scenes_without_image || []).length) {
      _naBits.push(`场景图 <b>${_na.scenes_without_image.length}</b> 张还没出：`
        + esc(_na.scenes_without_image.slice(0, 6).join('、')));
    }
    if ((_na.shots_without_scene || []).length) {
      _naBits.push(`第 ${esc(_na.shots_without_scene.join('、'))} 个镜头还**没有对应的场景卡**`
        + `（资产里新建一个场景、或让它按分镜文字自动匹配）`);
    }
    const needs = _naBits.length
      ? `<div class="gate-warn" style="border-color:#7a6a2a">📌 现在缺这些：<br>· `
        + _naBits.join('<br>· ') + `</div>` : '';
    // ★★ 2026-09-29（用户第 2、7 条）：模型**收不了参考图**时，卡上直接给一键换。
    //   后端 `model_fix` 里带着"当前是哪个 + 能换成哪些（含是否便宜）"，
    //   这里只负责画按钮 —— **换哪个由用户点**，不替他决定。
    const _mf = d.model_fix || {};
    const _pf = d.policy_fix || {};
    const policyFix = (_pf.images || []).length
      ? `<div class="gate-warn" style="border-color:#8a3a3a">
           🎨 这张参考图过不了平台审核，<b>换一张非写实的</b>就能解决（点一下直接重出）：
           ${_pf.images.map(im => `
             <div style="margin-top:6px">
               <span class="dim" style="font-size:12px">${esc(String(im.asset_name || im.filename || ''))}</span>
               <div style="margin-top:4px;display:flex;gap:6px;flex-wrap:wrap">
                 ${_pf.refine ? `
                   <button class="secondary-btn"
                     data-vf-refine-kind="${esc(im.asset_kind || '')}"
                     data-vf-refine-id="${esc(im.asset_id || '')}"
                     data-vf-refine-instruction="${esc((_pf.refine || {}).instruction || '')}"
                     title="在原图上改画风：保留五官/发型/服饰轮廓，只去掉照片感（图像编辑模型按张计费）">${esc(_pf.refine.label || '🖼 只改画风')}</button>
                 ` : ''}
                 ${(_pf.styles || []).map(st => `
                   <button class="secondary-btn"
                     data-vf-restyle="${esc(st.id)}"
                     data-vf-restyle-kind="${esc(im.asset_kind || '')}"
                     data-vf-restyle-id="${esc(im.asset_id || '')}"
                     title="用这个风格重出一张（图像模型按张计费）">重出 · ${esc(st.label)}</button>
                 `).join('')}
                 <button class="secondary-btn"
                   data-vf-stylize-kind="${esc(im.asset_kind || '')}"
                   data-vf-stylize-id="${esc(im.asset_id || '')}"
                   title="免费用本地 ffmpeg 柔化一版（不保证过审）">🖌 本地风格化（免费）</button>
               </div>
             </div>`).join('')}
           <div class="dim" style="margin-top:6px;font-size:12px">
             重出要花<b>图像模型的钱</b>（按张，比重出视频便宜两个量级）；本地风格化不花钱但不保证过审。
           </div>
         </div>` : '';

    const modelFix = (_mf.candidates || []).length
      ? `<div class="gate-warn" style="border-color:#8a5a2a">
           🔁 想让资产里的<b>角色/场景图真的出现在画面里</b>，得换模型。点一个就换（全部镜头）：
           <div style="margin-top:6px;display:flex;gap:6px;flex-wrap:wrap">
             ${_mf.candidates.map(c => `
               <button class="secondary-btn" data-vf-switch-model="${esc(c.id)}"
                 data-vf-switch-provider="${esc(_mf.provider || '')}"
                 title="${esc(c.why || '')}">换成 ${esc(c.label || c.id)}${c.cheap ? '（更省）' : ''}</button>
             `).join('')}
           </div>
           <div class="dim" style="margin-top:6px;font-size:12px">
             换一个支持「图生视频」的模型即可；换完这些按钮会自动消失。
           </div>
         </div>` : '';

    // ★ 2026-09-28（用户第 6 条）：把"当前内容"也挂成 data 属性，
    //   这样点「我要改一下」时弹窗里能**原样显示当前这一步是什么**，
    //   用户不用自己回忆刚才那张卡写了什么。
    const _argsTxt = (() => {
      try {
        const a = d.args || d.doing_args || {};
        const s = typeof a === 'string' ? a : JSON.stringify(a, null, 1);
        return (s && s !== '{}') ? s : '';
      } catch (e) { return ''; }
    })();
    return `<div class="agent-gate" data-gate-stage="${esc(d.stage)}"
      data-gate-args="${esc(_argsTxt)}"
      data-gate-tweaks="${esc((d.tweaks || []).join('|'))}">
      <div class="agent-gate-head">
        <span class="agent-gate-step">下一步</span>
        <b>${esc(d.title || d.stage)}</b>
        <span class="agent-gate-cost" data-gate-cost>${esc(d.cost_label || '')}</span>
        ${d.eta ? `<span class="dim" data-gate-eta>预计 ${esc(String(d.eta))}</span>` : ''}
      </div>
      <div class="agent-gate-why">${esc(String(d.why || ''))}</div>
      ${d.doing ? `<div class="agent-gate-doing">会做的事：${esc(String(d.doing))}</div>` : ''}
      ${d.note ? `<div class="agent-gate-note">${esc(String(d.note))}</div>` : ''}
      ${already}${warn}${needs}${modelFix}${policyFix}
      <div class="agent-gate-actions">
        <button class="primary-btn" data-vf-gate-act="confirm"
                data-stage="${esc(d.stage)}">✅ 确认，开始做</button>
        <button class="secondary-btn" data-vf-gate-act="modify"
                data-stage="${esc(d.stage)}">✏️ 我要改一下</button>
        <button class="secondary-btn" data-vf-gate-act="skip"
                data-stage="${esc(d.stage)}">⏭ 这步跳过</button>
      </div>
      ${tweaks ? `<div class="agent-gate-tweaks"><span class="dim">常见改法：</span>${tweaks}</div>` : ''}
      <div class="agent-gate-msg dim"></div>
    </div>`;
  },

  /** 点「确认」→ 直接调后端执行（确定性，不依赖模型理解"确认"两个字） */
  async confirmGate(stage, card) {
    let pid = this.currentProjectId();
    const msg = card ? card.querySelector('.agent-gate-msg') : null;
    const setMsg = (t, color) => {
      if (msg) { msg.textContent = t; msg.style.color = color || ''; }
    };
    if (!pid && card && card.closest) {
      // ★ 退路：从**这条回复的工具调用参数**里把项目 id 捡回来。
      //   agent 每次干活都带着 project_id（用户在气泡里也看得到），
      //   所以界面不该因为"没在项目列表里点过"就执行不了这一步。
      const box = card.closest('.msg-body') || card.closest('.msg');
      const row = box ? box.querySelector('.agent-step[data-pid]') : null;
      const fromTrace = row ? String(row.getAttribute('data-pid') || '') : '';
      if (fromTrace) {
        pid = fromTrace;
        await this.syncCurrentProject(pid);
      }
    }
    if (!pid) {
      // ★★ 第 40 轮改（用户实测就卡死在这里）：原来这句让用户
      //   「在左侧「项目」列表里点一下这个项目」—— 而**项目块已经从界面移除了**，
      //   用户根本没法照做，只能看着卡片点不动。
      //   现在给一条**真能做得到**的路：在对话里说一句项目名即可 ——
      //   agent 手上有完整上下文，认下项目就能执行。
      setMsg('这一步还没绑定到项目，我不敢直接执行（怕花错项目的钱）。'
             + '在下面回一句「就用《…》那个项目」，我认下项目立刻执行这一步。',
             'var(--error)');
      Toast.error('还没绑定项目 —— 在对话里说一句项目名即可');
      return;
    }
    card && card.querySelectorAll('button').forEach(b => { b.disabled = true; });
    setMsg('正在执行，可能要几分钟，别关页面…');

    // ★ 会话要留下痕迹：把"确认"当成一条用户消息，之后所有结果都挂在这个上下文里。
    //   否则用户回看历史会看到"凭空冒出来的结果"，不知道是谁触发的。
    this.messages.push({ role: 'user', content: `确认：${stage}`,
                         timestamp: Date.now() });
    const aiMsg = { role: 'assistant', content: '', steps: [],
                    timestamp: Date.now(), model: '' };
    this.messages.push(aiMsg);

    try {
      const r = await request('POST', `/api/projects/${pid}/stage/confirm`,
                              { stage });
      const res = (r && r.data) || {};
      const step = { tool: res.tool || stage, ok: res.ok !== false,
                     data: this._slimForHistory(res) };
      aiMsg.steps.push(step);
      if (res.ok === false) {
        aiMsg.content = `「${stage}」没做成：${res.error || '未知错误'}`;
        setMsg('执行失败：' + (res.error || ''), 'var(--error)');
      } else {
        aiMsg.content = res.summary || `「${stage}」这一步做完了。`;
        setMsg('✅ 做完了');
      }
    } catch (e) {
      const step = { tool: stage, ok: false, data: { error: String(e.message || e) } };
      aiMsg.steps.push(step);
      aiMsg.content = `「${stage}」执行失败：${e.message || e}`;
      setMsg('失败：' + (e.message || e), 'var(--error)');
    }

    // ══════════════════════════════════════════════════════════════
    // ★★ 一键流水线：这一步做完 → **自动把下一步的卡片递上来**
    //
    // 为什么必须做（用户实测反馈："新的使用流程跑不通、没法一路交付"）：
    //   这个按钮走的是 **HTTP 直连**（/stage/confirm），**不经过模型**。
    //   而"下一步是哪个阶段、要用 propose_step 提给用户"那句提示，是
    //   `run_stage()` 塞进返回里**给模型看的**（next_stage / next_hint）——
    //   模型根本没机会看到它（我们把模型绕过去了）。
    //   ⇒ 结果：点一次「确认」执行完，界面就**停在那里**，没有任何"下一步"
    //     的卡片，只能自己想一句"继续"去催模型 —— 每步都断一次，跑不到交付。
    //
    // 修法：执行成功后**直接查一次流水线**，把下一步作为一张新卡片追加到
    //   这条回复里（形状与 pipeline_status 的结果一致，所以
    //   renderResultDetail 会照常画出那张卡）。
    //   ⇒ 用户只需要**反复点「✅ 确认，开始做」**，一步一确认，一路走到
    //     "后期成片" —— 这就是"一键说明、点确认执行、最终交付"。
    //   ★ 它**不会**自动执行任何东西：每张卡还是要人点一下才动，
    //     花钱的那几步照旧停在面前（这是刻意的，别改成自动跑）。
    // ══════════════════════════════════════════════════════════════
    if (aiMsg.content && !/没做成|执行失败/.test(aiMsg.content)) {
      try {
        const pr = await request('GET', `/api/projects/${pid}/pipeline`);
        const pd = (pr && pr.data) || {};
        const nx = pd.next;
        const doneN = Number(pd.done_count || 0) + Number(pd.skipped_count || 0);
        const totalN = Number(pd.total || 9);
        // ★★ 2026-09-27 第 48 轮（用户第 9 条）：
        //   「角色、场景、角色对应的配音……做完就停，**不要进行下一步**
        //    （分镜、场景视频等等）」。
        //   所以「角色外观」这一步做完之后，**不自动把分镜卡片递上来** ——
        //   改成停下来问一句。用户想在资产区反复改角色/场景/配音的时候就改，
        //   说一声「继续」才往下走。（卡片照旧不自动执行任何东西，这一点没变。）
        if (stage === 'looks') {
          // ★★★ 2026-09-29（用户第 5 条：「点确认就直接做，不要再让我打字」）
          //   原来这里让用户**手打**「继续」。用户的原话是
          //   「对话中出现的确认开始做在用户点击后要直接开始做，
          //     而不是还要输入确认再动手」—— 让他打字就是同一类毛病。
          //   现在给一个**按钮**：「▶ 继续做分镜表」，点一下就等于说了继续。
          aiMsg.content += `\n\n**角色 / 场景 / 配音这一步已经做完了** ✓ `
            + `你可以先去「资产」里看：出得不满意就说「重出某某的定妆照」或`
            + `「把某某改成……」，我会在资产库里改（不用重跑整条流程）。`
            + `\n\n<div class="agent-gate-actions">`
            + `<button class="primary-btn" data-vf-continue="1">`
            + `▶ 继续做分镜表</button>`
            + `<button class="secondary-btn" data-vf-goto="assets">`
            + `先去资产里看看</button></div>`;
          this.saveConversations();
          this.renderMessages();
          return;
        }
        if (nx && nx.gate) {
          aiMsg.steps.push({
            tool: 'pipeline_status', ok: true,
            data: Object.assign({}, pd, { next: nx }),
          });
          aiMsg.content += `\n\n▼ **下一步：「${nx.title}」**（${nx.cost_label || '免费'}`
            + `${nx.eta ? '，预计 ' + nx.eta : ''}）—— `
            + `看完下面的卡片，点「✅ 确认，开始做」就继续。`;
        } else if (nx) {
          // 有下一步、但它不需要确认（免费且没有闸门）—— 照样告诉用户，
          // 不要"什么都不说"（用户会以为卡住了）
          aiMsg.content += `\n\n▼ **下一步：「${nx.title}」**（${nx.cost_label || '免费'}）—— `
            + `说一句「继续」我就做。`;
        } else if (doneN >= totalN) {
          // ★★ 只有**所有阶段都完成或跳过**时才敢说"走完了"。
          //   改这里的原因（2026-09-27 第 46 轮，用户实测）：
          //   用户确认完「角色外观」后，界面写了
          //   「🎉 **流水线走完了** —— 没有下一步了」，而那时分镜/白膜/成片都还没做。
          //   原来只要 `/pipeline` 里 `next` 为空就说"走完了" ——
          //   等于把"我没查到"当成"已经做完"，直接把用户堵死在半路
          //   （他接着只好自己打「确认」，又被这段文字搞糊涂）。
          aiMsg.content += `\n\n🎉 **流水线走完了** —— ${totalN} 个阶段全部完成或跳过了。`;
        } else {
          // 没查到下一步，但**明显还没做完**：如实说，并给一条出路
          //
          // ★★★ 2026-09-29（用户第 5 条 + 他截图里的原话）
          //   截图里 AI 说：「**下一步我这边没查到** —— 已完成 0/9 步，
          //     可能状态剧变。你说一句「继续」，我就接着往下走。」
          //   查清了：那种"0/9 且查不到"的场景，是**项目读不出来**
          //   （界面还停在一个已被删除的项目上）。
          //   旧文案对用户毫无帮助，还让他白打一个「继续」。
          //   现在把"项目读不到"和"确实没有下一步"分开说，并且**给按钮**。
          if (!pd || (!pd.stages && !pd.total)) {
            aiMsg.content += `\n\n⚠ **这一步做完了，但我读不到这个项目的进度** ——`
              + `它可能已经被删掉了，或者界面还停在一个不存在的项目上。`
              + `\n\n<div class="agent-gate-actions">`
              + `<button class="primary-btn" data-vf-list-projects="1">`
              + `看看我有哪些项目</button></div>`;
          } else {
            aiMsg.content += `\n\n（这一步做完了。下一步我这边**没查到** —— `
              + `已完成 ${doneN}/${totalN} 步，可能是刚刚状态变了。`
              + `\n\n<div class="agent-gate-actions">`
              + `<button class="primary-btn" data-vf-continue="1">`
              + `▶ 再查一次，接着往下走</button></div>`;
          }
        }
      } catch (e) {
        // 取不到下一步不影响"这一步做完了"这件事，如实记在控制台即可
        console.warn('[chat] 取下一步失败（卡片没递上来）：', e);
      }
    }

    this.saveConversations();
    this.renderMessages();
  },

  /** 点「跳过」→ 记下来，之后进度里不再提示这一步 */
  async skipGate(stage, card) {
    let pid = this.currentProjectId();
    if (!pid && card && card.closest) {
      const box = card.closest('.msg-body') || card.closest('.msg');
      const row = box ? box.querySelector('.agent-step[data-pid]') : null;
      pid = row ? String(row.getAttribute('data-pid') || '') : '';
      if (pid) await this.syncCurrentProject(pid);
    }
    if (!pid) { Toast.error('还没绑定项目 —— 在对话里说一句项目名即可'); return; }
    const msg = card ? card.querySelector('.agent-gate-msg') : null;
    card && card.querySelectorAll('button').forEach(b => { b.disabled = true; });
    try {
      await request('POST', `/api/projects/${pid}/stage/skip`,
                    { stage, reason: '用户在对话里点了跳过' });
      if (msg) { msg.textContent = '已跳过这一步'; msg.style.color = 'var(--success)'; }
      Toast.success('已跳过');
    } catch (e) {
      if (msg) { msg.textContent = '跳过失败：' + (e.message || e); msg.style.color = 'var(--error)'; }
      card && card.querySelectorAll('button').forEach(b => { b.disabled = false; });
    }
  },

  /**
   * 点「✏ 我要改一下」→ **弹出这张卡当前的内容**，让用户照着改（用户第 6 条）。
   *
   * 原话：「用户点击"我要改一下"，要弹出详细的当前内容，用户输入好对应的
   *        修改意见后执行！」
   *
   * 原来这里只是把「把「X」改成：」塞进输入框 —— 用户**看不到当前到底是什么**，
   * 也没法对着改（他得自己回忆刚才那张卡写了什么）。现在：
   *   · 弹窗上半部分是**当前这一步的真实内容**（会做什么 / 参数 / 成本 / 时间）；
   *   · 下半部分是一个输入框 + 几个常用改法的快捷键；
   *   · 提交后**直接发出这条修改意见**（模型会走 revise_step 改参数，
   *     改完**再给他确认一次** —— 改完不确认就执行等于替他决定）。
   */
  useTweak(text, card) {
    const box = document.getElementById('chatInput');
    const stage = (card && (card.dataset.gateStage || '')) || '';
    let doing = '', cost = '', eta = '', args = '';
    try {
      args = (card && card.getAttribute('data-gate-args')) || '';
    } catch (e) { args = ''; }
    const txt = (sel) => {
      const el = card && card.querySelector(sel);
      return el ? (el.textContent || '').trim() : '';
    };
    doing = txt('.agent-gate-doing') || txt('.agent-gate-msg');
    cost = txt('[data-gate-cost]');
    eta = txt('[data-gate-eta]');
    const tweaks = (card && card.getAttribute('data-gate-tweaks') || '')
      .split('|').filter(Boolean);

    const old = document.getElementById('vfTweakModal');
    if (old) old.remove();
    const wrap = document.createElement('div');
    wrap.id = 'vfTweakModal';
    wrap.className = 'vf-media-overlay';
    wrap.style.display = 'flex';
    wrap.innerHTML = `
      <div class="modal" style="max-width:640px;width:92%;background:var(--panel,#1b1b1f);
           border:1px solid var(--border,#333);border-radius:12px;padding:18px 20px">
        <div style="font-weight:700;margin-bottom:10px">✏ 改这一步：${escapeHtml(stage || '当前步骤')}</div>
        <div style="font-size:13px;line-height:1.7;opacity:.9">
          ${doing ? '<b>现在打算这么做：</b><br>' + escapeHtml(doing) + '<br>' : ''}
          ${cost || eta ? '<b>成本/时间：</b>' + escapeHtml((cost + ' ' + eta).trim()) + '<br>' : ''}
          ${args ? '<b>当前参数：</b><br><code style="word-break:break-all">' + escapeHtml(args) + '</code>' : ''}
        </div>
        <div style="margin-top:14px">
          <label style="display:block;font-size:13px;margin-bottom:6px">
            你想怎么改？（例如：时长改成 5 秒 / 只做主角 / 换固定机位 / 去掉字幕）
          </label>
          <textarea id="vfTweakText" rows="3" style="width:100%;padding:8px;border-radius:8px;
            border:1px solid var(--border,#333);background:transparent;color:inherit;resize:vertical"
            placeholder="在这里写你的修改意见…"></textarea>
        </div>
        ${tweaks.length ? `<div style="margin-top:10px;font-size:12px;opacity:.85">
          常用改法（点一下就填进去）：${tweaks.map(t =>
            `<button class="secondary-btn" data-vf-tweak-fill="${escapeHtml(t)}"
               style="margin:2px 4px 2px 0">${escapeHtml(t)}</button>`).join('')}
        </div>` : ''}
        <div style="margin-top:16px;display:flex;gap:10px;justify-content:flex-end">
          <button class="secondary-btn" id="vfTweakCancel">取消</button>
          <button class="primary-btn" id="vfTweakOk">提交修改</button>
        </div>
        <div id="vfTweakMsg" style="margin-top:8px;font-size:12px"></div>
      </div>`;
    document.body.appendChild(wrap);
    const ta = wrap.querySelector('#vfTweakText');
    if (text && text.indexOf('改成：') < 0) ta.value = text;   // 常见改法直接填进去
    ta.focus();
    wrap.querySelector('#vfTweakCancel').onclick = () => wrap.remove();
    wrap.querySelectorAll('[data-vf-tweak-fill]').forEach(b => {
      b.onclick = () => { ta.value = b.getAttribute('data-vf-tweak-fill'); ta.focus(); };
    });
    wrap.querySelector('#vfTweakOk').onclick = () => {
      const v = (ta.value || '').trim();
      if (!v) { wrap.querySelector('#vfTweakMsg').textContent = '先写一句要改什么'; return; }
      wrap.remove();
      // ★ 直接作为一条用户消息发出去：模型会走 revise_step 改参数，
      //   改完**再给用户确认一次**（改完自动执行 = 替他做决定，不行）。
      const box2 = document.getElementById('chatInput');
      if (box2) box2.value = `把「${stage}」改成：${v}`;
      const send = document.getElementById('sendChatBtn');
      if (send) send.click();
      Toast.info('已把你的修改意见发出去，改完会让你再确认一次');
    };
  },

  /** 全局委托：待确认卡片上的三个按钮 */
  bindGateButtons() {
    if (window.__vfGateBound) return;
    window.__vfGateBound = true;
    // ★ 「本机播放」：浏览器里播不出来的视频，交给系统播放器（第 72 轮）
    document.addEventListener('click', (e) => {
      const b = e.target.closest && e.target.closest('[data-vf-open-file]');
      if (!b) return;
      e.preventDefault();
      const u = b.getAttribute('data-vf-open-file') || '';
      request('POST', '/api/open-file', { url: u })
        .then(() => Toast.success('已用系统播放器打开'))
        .catch(err => Toast.error('打不开：' + (err.message || err)));
    });
    document.addEventListener('click', (e) => {
      // ★★★ 2026-09-29（用户第 5 条：「点一下就做，不要再让我打字」）
      //   两个一键按钮：
      //     ▶ 继续 / 再查一次  → 直接当作"用户说了继续"发一条消息出去
      //     看看我有哪些项目     → 直接问他有哪些项目（不用他手打）
      //   ⚠ 必须**发一条普通的用户消息**（走正常流程），
      //     不能在这里偷偷执行——执行动作该由上面的"确认"按钮负责。
      const cont = e.target.closest && e.target.closest('[data-vf-continue]');
      if (cont) {
        e.preventDefault();
        cont.disabled = true;
        this.sendMessage('继续');
        return;
      }
      const lp = e.target.closest && e.target.closest('[data-vf-list-projects]');
      if (lp) {
        e.preventDefault();
        lp.disabled = true;
        this.sendMessage('列出我现在的所有项目');
        return;
      }
      const goto = e.target.closest && e.target.closest('[data-vf-goto]');
      if (goto) {
        e.preventDefault();
        const page = goto.getAttribute('data-vf-goto') || 'assets';
        if (typeof window.navigateTo === 'function') window.navigateTo(page);
        return;
      }
      // ★ 2026-09-29（用户第 2 条）：参考图过不了平台隐私审核时的两条路 ——
      //   ① 用**非写实风格重出**（花钱：图像模型按张计费）
      //   ② **本地 ffmpeg 风格化**（免费，但不保证过审）
      // ★ 2026-09-29（第 2 条）：**只在原图上改画风** —— 保留五官/发型/服饰轮廓，
      //   只把"照片感"去掉。比重画一张更可能同时满足平台隐私策略与"角色还是那个角色"。
      const rf = e.target.closest && e.target.closest('[data-vf-refine-kind]');
      if (rf) {
        e.preventDefault();
        const kind = rf.getAttribute('data-vf-refine-kind') || '';
        const aid = rf.getAttribute('data-vf-refine-id') || '';
        const pid = (State.currentProject && State.currentProject.id) || '';
        if (!pid || !aid || !kind) { Toast.error('拿不到资产信息'); return; }
        // 指令**直接写在按钮上**（后端给的那套），不在前端另写一份 ——
        // 两份文案必然漂移（这个仓库里栽过好几次）。
        const ins = rf.getAttribute('data-vf-refine-instruction')
          || '把这张图改成中国水墨插画风格：去掉照片质感与皮肤细节，改为写意笔触与色块；'
             + '保持人物五官比例、发型、服饰轮廓与整体构图不变。';
        const keep = ['人物五官与脸型', '发型', '服饰轮廓', '构图与站姿'];
        rf.disabled = true;
        Toast.info('正在原图上改画风（图像编辑模型，按张计费，约 1~3 分钟）…');
        API.images.refine(pid, kind, aid, { instruction: ins, keep })
          .then(() => {
            Toast.success('已按"只改画风"重做这张图；新图没被拒过的话，警告会自动消失');
            window.dispatchEvent(new CustomEvent('vf:assets-changed'));
          })
          .catch(err => {
            rf.disabled = false;
            Toast.error('改画风失败：' + (err.message || err));
          });
        return;
      }
      const rs = e.target.closest && e.target.closest('[data-vf-restyle]');
      if (rs) {
        e.preventDefault();
        const style = rs.getAttribute('data-vf-restyle') || '';
        const kind = rs.getAttribute('data-vf-restyle-kind') || '';
        const aid = rs.getAttribute('data-vf-restyle-id') || '';
        const pid = (State.currentProject && State.currentProject.id) || '';
        if (!pid || !aid || !kind) { Toast.error('拿不到资产信息'); return; }
        rs.disabled = true;
        Toast.info('正在用非写实风格重出这张图（图像模型按张计费，约 1~4 分钟）…');
        const path = kind === 'scene'
          ? `/api/projects/${pid}/scenes/${aid}/generate-image`
          : `/api/projects/${pid}/characters/${aid}/generate-image`;
        request('POST', path, { style })
          .then(() => {
            Toast.success('已重出这张参考图；卡片上的警告会在新图没被拒过时自动消失');
            window.dispatchEvent(new CustomEvent('vf:assets-changed'));
          })
          .catch(err => {
            rs.disabled = false;
            Toast.error('重出失败：' + (err.message || err));
          });
        return;
      }
      const stz = e.target.closest && e.target.closest('[data-vf-stylize-kind]');
      if (stz) {
        e.preventDefault();
        const kind = stz.getAttribute('data-vf-stylize-kind') || '';
        const aid = stz.getAttribute('data-vf-stylize-id') || '';
        const pid = (State.currentProject && State.currentProject.id) || '';
        if (!pid || !aid || !kind) { Toast.error('拿不到资产信息'); return; }
        stz.disabled = true;
        request('POST', `/api/projects/${pid}/assets/${kind}/${aid}/stylize`, {})
          .then(r => {
            const n = ((r && r.data) || {}).note || '';
            Modal.open({ title: '🖌 本地风格化（免费）已完成',
                         html: `<div class="modal-text">${renderMarkdownOnce(n)}</div>`,
                         okText: '知道了', cancelText: null });
          })
          .catch(err => {
            stz.disabled = false;
            Toast.error('风格化失败：' + (err.message || err));
          });
        return;
      }
      // ★ 2026-09-29（用户第 2、7 条）：卡片上的「🔁 换成 XXX」——
      //   一键把**全部镜头**换成支持参考图的模型。换哪个由用户点。
      const sw = e.target.closest && e.target.closest('[data-vf-switch-model]');
      if (sw) {
        e.preventDefault();
        const mid = sw.getAttribute('data-vf-switch-model') || '';
        const prov = sw.getAttribute('data-vf-switch-provider') || '';
        const pid = (State.currentProject && State.currentProject.id) || '';
        if (!pid || !mid) { Toast.error('拿不到项目或模型名'); return; }
        sw.disabled = true;
        request('POST', `/api/projects/${pid}/shots/model`,
                { model_name: mid, model_provider: prov })
          .then(r => {
            const d = (r && r.data) || {};
            Toast.success((d.note || '已换模型').slice(0, 120));
            // 让卡片上的提示刷新（重新渲染消息即可）
            try { window.dispatchEvent(new CustomEvent('vf:assets-changed')); } catch (err) {}
          })
          .catch(err => {
            sw.disabled = false;
            Toast.error('换模型失败：' + (err.message || err));
          });
        return;
      }
      const t = e.target.closest && e.target.closest('[data-vf-gate-tweak]');
      if (t) { e.preventDefault(); this.useTweak(t.getAttribute('data-vf-gate-tweak'),
                                                 t.closest('.agent-gate')); return; }
      const btn = e.target.closest && e.target.closest('[data-vf-gate-act]');
      if (!btn) return;
      e.preventDefault();
      const card = btn.closest('.agent-gate');
      const stage = btn.getAttribute('data-stage') || (card && card.dataset.gateStage) || '';
      const act = btn.getAttribute('data-vf-gate-act');
      if (act === 'confirm') this.confirmGate(stage, card);
      else if (act === 'skip') this.skipGate(stage, card);
      else if (act === 'modify') this.useTweak('', card);
    });
  },

  // ──────────────────────── 通用媒体渲染 ────────────────────────
  // 按**载荷形状**识别图片/视频，而不是按工具名。这样任何工具只要
  // 返回了媒体字段，对话里就一定能看到图、能下载、能存资产库。

  /** 专门分支已经画过图的工具 —— 别再兜底画一遍，否则同一张图出现两次 */
  _MEDIA_HANDLED_TOOLS: new Set(['render_previz', 'kling_generate',
                                 'kling_white_model', 'kling_status',
                                 'kling_upload', 'kling_element',
                                 'kling_elements', 'kling_task']),

  /** 一串 URL 里挑出图片和视频（判据同 `_asMedia`：看 path 参数里的真扩展名） */
  _splitMedia(urls) {
    const imgs = [], vids = [];
    (urls || []).forEach(u => {
      if (typeof u !== 'string' || !u) return;
      const it = this._asMedia(u);
      if (!it) return;
      (it.kind === 'video' ? vids : imgs).push(u);
    });
    return { imgs, vids };
  },

  /**
   * 从工具结果里挖出所有媒体。返回 [{url, kind, name}]。
   * 认识这些形状：
   *   · d.path / d.image_path / d.reference_image_path    单张图（本地路径）
   *   · d.paths / d.images / d.image_paths / d.photos      多张图
   *   · d.video / d.video_path / d.video_url / d.mp4       单段视频
   *   · d.urls / d.outputs                                 混合
   *   · d.items[{kind, name, path}] / d.made[]             资产批量出图（本项目新增）
   *   · d.made / d.updated 是数字的情况要跳过（那是计数，不是 URL）
   */
  _collectMedia(tool, d) {
    const out = [];
    const seen = new Set();
    const push = (u, kind, name) => {
      if (typeof u !== 'string' || !u.trim()) return;
      u = u.trim();
      // 本地绝对路径 → 走 /api/media 才能在 WebView 里显示
      if (/^[a-zA-Z]:[\\/]/.test(u) || (u.startsWith('\\\\'))) {
        u = '/api/media?path=' + encodeURIComponent(u);
      }
      const key = u;
      if (seen.has(key)) return;
      seen.add(key);
      out.push({ url: u, kind: kind || 'image', name: name || '' });
    };

    const asList = (v) => Array.isArray(v) ? v : (typeof v === 'string' && v ? [v] : []);
    const labelOf = (x, i) => (x && typeof x === 'object')
      ? (x.name || x.label || x.title || `第 ${i + 1} 个`) : '';

    // 单张图
    ['image_path', 'reference_image_path', 'image', 'thumbnail'].forEach(k => {
      if (typeof d[k] === 'string') push(d[k], 'image', '');
    });
    // 多张图
    ['images', 'image_paths', 'photos', 'frames', 'frame_urls'].forEach(k => {
      asList(d[k]).forEach((u, i) => push(u, 'image', labelOf(u, i)));
    });
    // 视频
    ['video', 'video_path', 'video_url', 'mp4', 'output', 'coverage_cut'].forEach(k => {
      if (typeof d[k] === 'string') push(d[k], 'video', '');
    });
    // 混合
    ['urls', 'outputs', 'media'].forEach(k => {
      asList(d[k]).forEach((u, i) => push(u, '', labelOf(u, i)));
    });
    // 资产批量出图：items=[{kind, name, path}] / errors 里没有 path 要跳过
    asList(d.items).forEach((x, i) => {
      if (x && typeof x === 'object' && typeof x.path === 'string') {
        push(x.path, 'image', x.name || labelOf(x, i));
      }
    });
    asList(d.assets).forEach((x, i) => {
      if (x && typeof x === 'object' && typeof x.path === 'string') {
        push(x.path, 'image', x.name || labelOf(x, i));
      }
    });
    return out;
  },

  /** 渲染通用媒体区（图片画廊 + 视频 + 每个都带下载/存资产） */
  renderGenericMedia(tool, d) {
    if (!d || typeof d !== 'object') return '';
    if (this._MEDIA_HANDLED_TOOLS.has(tool)) return '';
    const media = this._collectMedia(tool, d);
    if (!media.length) return '';

    const esc = escapeHtml;
    const cards = media.map((m, i) => {
      const mi = this._asMedia(m.url) || {};
      const isVideo = m.kind === 'video' || mi.kind === 'video';
      const base = (m.name || `${tool}_${i + 1}`).replace(/[\\/:*?"<>|]/g, '_');
      const fname = base + (isVideo ? '.mp4' : '.png');
      const body = isVideo
        ? `<video src="${esc(m.url)}" controls preload="metadata" playsinline
                  onerror="window.__vfVideoError && window.__vfVideoError(this)"></video>
           <div class="agent-media-fallback" hidden></div>`
        : `<a href="${esc(m.url)}" target="_blank" title="点开看大图">
             <img class="agent-frame" src="${esc(m.url)}" alt="${esc(m.name || '生成结果')}"
                  loading="lazy"></a>`;
      return `<div class="agent-media-card">
        ${m.name ? `<div class="agent-media-name">${esc(m.name)}</div>` : ''}
        ${body}
        <div class="agent-previz-actions">
          ${this.mediaActions(m.url, { filename: fname, dlLabel: '下载',
                                       saveLabel: isVideo ? '' : '存为资产',
                                       savable: !isVideo })}
        </div>
      </div>`;
    }).join('');

    const nImg = media.filter(m => !/\.(mp4|webm|mov|mkv|m4v)(\?|#|$)/i.test(m.url)).length;
    const nVid = media.length - nImg;
    const head = `🖼 产出 ${[
      nImg ? `${nImg} 张图` : '', nVid ? `${nVid} 段视频` : '',
    ].filter(Boolean).join(' · ')}`;

    return `<div class="agent-media">
      <div class="agent-media-head">${head}
        <span class="dim">都能下载，图还能一键存进资产库</span></div>
      <div class="agent-media-grid">${cards}</div>
    </div>`;
  },

  // ──────────────────────── 产物操作：下载 / 存资产库 ────────────────────────
  // 用户要求：「对话过程中产品的资产、视频都支持下载保存，存资产库」。
  // 所以对话里出现的每一张图、每一段视频，都要能：
  //   ① 一键下载到本机
  //   ② 一键存成「角色形象 / 场景图」（写进资产库，后面所有镜头都引用它）

  /** 下载按钮。`url` 可以直接是 /api/media?path=... 这类站内地址 */
  dlBtn(url, filename, label) {
    const esc = escapeHtml;
    if (!url) return '';
    return `<a class="secondary-btn" href="${esc(url)}"
      download="${esc(filename || '')}"
      title="下载到本机（浏览器会问你存哪儿）">⬇ ${esc(label || '下载')}</a>`;
  },

  /** 「存为资产」按钮：把这张图设成某个角色/场景的参考图 */
  saveAssetBtn(url, label) {
    const esc = escapeHtml;
    if (!url) return '';
    return `<button class="secondary-btn" data-vf-save-asset="${esc(url)}"
      title="把这张图存成角色形象或场景图，之后所有镜头都会引用它">📌 ${esc(label || '存为资产')}</button>`;
  },

  /** 媒体操作条（下载 + 存资产），复用到所有出图/出片的地方 */
  mediaActions(url, opts) {
    const o = opts || {};
    const bits = [this.dlBtn(url, o.filename, o.dlLabel)];
    // ★ 视频多给一个「在系统播放器里打开」（2026-09-27 第 72 轮）。
    //   用户原话「对话框里面的视频看不了」—— 浏览器/WebView2 里播不出来的，
    //   用系统播放器一定能看（桌面版后端直接 shell 打开）。
    if (o.playable !== false && this._asMedia && (this._asMedia(url) || {}).kind === 'video') {
      bits.push(`<button class="secondary-btn" data-vf-open-file="${escapeHtml(url)}"
        title="用系统默认播放器打开（浏览器里播不动时用这个）">▶ 本机播放</button>`);
    }
    if (o.savable !== false) bits.push(this.saveAssetBtn(url, o.saveLabel));
    return bits.filter(Boolean).join('');
  },

  /** 从对话里把一张图存成资产 —— 弹一个小选择框 */
  async saveAsAsset(url) {
    const esc = escapeHtml;
    if (!url) return;
    const pid = this.currentProjectId();
    if (!pid) { Toast.error('先绑定一个项目，再存资产。'); return; }
    let chars = [], scenes = [];
    try {
      const [cd, sd] = await Promise.all([
        API.characters.list(pid).catch(() => ({})),
        API.scenes.list(pid).catch(() => ({})),
      ]);
      chars = cd.characters || [];
      scenes = sd.scenes || [];
    } catch (e) { /* 下面按空处理 */ }

    const opt = (kind, arr, idKey) => arr.map(x =>
      `<option value="${kind}:${esc(x.id)}">${esc(x.name || x.id)}</option>`).join('');
    const html = `
      <div class="modal-text">把这张图存成资产后，<b>后面每个镜头都会引用它</b> ——
        这是跨镜头保持一致的关键。</div>
      <div style="margin-top:10px">
        <label style="display:block;font-size:13px;margin-bottom:6px">存成哪个资产？</label>
        <select id="vfSaveTarget" style="width:100%;padding:8px;border-radius:8px;
          background:var(--bg-2);border:1px solid var(--border-1);color:var(--text-primary)">
          ${chars.length ? `<optgroup label="角色">${opt('character', chars)}</optgroup>` : ''}
          ${scenes.length ? `<optgroup label="场景">${opt('scene', scenes)}</optgroup>` : ''}
          ${(!chars.length && !scenes.length)
            ? '<option value="">（这个项目还没有角色/场景，先去资产页建一个）</option>' : ''}
        </select>
      </div>`;

    Modal.open({
      title: '📌 存为资产', html, okText: '存进去', cancelText: '取消',
      onOk: async () => {
        const v = (document.getElementById('vfSaveTarget') || {}).value || '';
        if (!v) { Toast.error('先建一个角色或场景'); return false; }
        const [kind, id] = v.split(':');
        try {
          // ★ 走 attach-image 而不是直接 PATCH reference_image_path。
          //   那个字段后端当**文件路径**用，塞 URL 会：① 站内地址 os.path.exists
          //   永远 False，生成时才炸；② 厂商外链 24 小时过期，资产悄悄失效。
          //   attach-image 会把字节落盘 + 校验真的是图片，再写库。
          const api = (kind === 'character') ? API.characters : API.scenes;
          if (api.attachImage) {
            const r = await api.attachImage(id, url);
            const d = (r && r.data) || {};
            if (d.origin === 'downloaded') {
              Toast.success('已存进资产库（图片已下载到本机，不会再过期）');
            } else {
              Toast.success('已存进资产库 —— 后面的镜头会自动引用它');
            }
          } else {
            // 后端版本较老时的退路，行为与以前一致
            await api.update(id, { reference_image_path: url });
            Toast.success('已存进资产库（老接口，未落盘）');
          }
          window.dispatchEvent(new CustomEvent('vf:assets-changed'));
          return true;
        } catch (e) {
          Toast.error('存失败：' + (e.message || e));
          return false;
        }
      },
    });
  },

  // 白膜"能不能真的约束生成"要说清楚 —— 渲好了 ≠ 用上了。
  // 参考视频必须是公网 URL（实测：base64 和本地路径都被平台拒），
  // 内网机器默认拿不到，这时必须如实告诉用户，不能让他以为白膜生效了。
  renderPrevizConstraint(c) {
    if (!c) return '';
    if (c.usable) {
      return `<div class="agent-previz-ok">✓ 这版白膜会作为参考素材发给模型，
        用来约束运镜和节奏。（${escapeHtml(String(c.reason || '').slice(0, 90))}）</div>`;
    }
    return `<div class="agent-previz-degrade">ℹ 白膜已渲好，但<b>这次发不出去</b>：
      ${escapeHtml(String(c.reason || '').slice(0, 200))}
      <div class="dim">它仍然有用 —— 让你在花钱前把运镜和节奏定下来。</div></div>`;
  },

  appendMessage(m) {    const container = document.getElementById('chatMessages');
    const div = document.createElement('div');
    div.innerHTML = this.renderMessage(m, this.messages.indexOf(m));
    container.appendChild(div.firstElementChild);
    this.scrollToBottom();
    return container.lastElementChild;
  },

  /** 全局委托：对话里所有「📌 存为资产」按钮都走这里（事件委托，动态插入也能用） */
  bindAssetSaver() {
    if (window.__vfAssetSaverBound) return;
    window.__vfAssetSaverBound = true;
    document.addEventListener('click', (e) => {
      const btn = e.target.closest && e.target.closest('[data-vf-save-asset]');
      if (!btn) return;
      e.preventDefault();
      this.saveAsAsset(btn.getAttribute('data-vf-save-asset'));
    });
  },

  updateAIMessage(el, content) {
    if (!el) return;
    const contentEl = el.querySelector('.msg-content');
    // 重新解析 markdown（**只转义一次** —— 见 `renderMarkdownOnce`）
    contentEl.innerHTML = renderMarkdownOnce(content);

    // 重新绑定复制按钮
    contentEl.querySelectorAll('.msg-code-copy').forEach(btn => {
      btn.addEventListener('click', () => {
        navigator.clipboard.writeText(content);
        Toast.success('已复制');
      });
    });
  },

  scrollToBottom(instant) {
    // ★★ 2026-09-27 第 46 轮（用户第 3 条）：「重新进入对话要默认停在最新消息，
    //   不要从顶部滑下来」。
    //   原来只有 `behavior:'smooth'` —— 打开一段长对话时，浏览器先渲染在顶部，
    //   然后**平滑滚动**几屏才到底，用户看到的就是"从上往下滑"。
    //   打开会话时应该**直接**到底（instant），流式输出时才用平滑。
    //   另外：滚动容器在不同布局下不一样（整页 / .content / #chatMessages），
    //   所以这里把**所有可滚动的祖先**都滚到底 —— 宁可多滚几个，也不要漏。
    const behavior = instant ? 'auto' : 'smooth';
    const targets = new Set();
    const msgs = document.getElementById('chatMessages');
    const area = document.querySelector('.content');
    if (msgs) targets.add(msgs);
    if (area) targets.add(area);
    let p = msgs ? msgs.parentElement : null;
    while (p && p !== document.body) {
      try {
        const st = window.getComputedStyle(p);
        if (/(auto|scroll|overlay)/.test(String(st.overflowY || ''))) targets.add(p);
      } catch (e) { /* 拿不到样式就跳过，不影响主流程 */ }
      p = p.parentElement;
    }
    targets.forEach(el => {
      try { el.scrollTo({ top: el.scrollHeight, behavior }); }
      catch (e) { el.scrollTop = el.scrollHeight; }
    });
    try {
      window.scrollTo({ top: document.body.scrollHeight, behavior });
    } catch (e) {
      window.scrollTo(0, document.body.scrollHeight);
    }
  },

  saveCurrentConv() {
    const conv = this.conversations.find(c => c.id === this.currentConvId);
    if (conv) {
      conv.messages = this.messages.filter(m => !m.streaming);
      conv.updated_at = new Date().toISOString();
    }
    this.saveConversations();
    this.syncToServer(conv);   // 同步到服务端 SQLite，跨会话/卸载持久
    this.renderConversations();
  },
};

// 全局函数：发送
window.sendChat = function() {
  const input = document.getElementById('chatInput');
  if (!input) return;
  const content = input.value;
  // ★ 只带了附件、没打字，也算一条有效消息（用户很自然会「拖个文件就发」）
  const hasAttach = !!(Chat.attachments && Chat.attachments.length);
  if (!content.trim() && !hasAttach) {
    if (window.Toast) Toast.info('请输入内容，或先点 📎 添加附件');
    return;
  }
  if (Chat.streaming) {
    if (window.Toast) Toast.warn('上一条还在生成中，请稍候…');
    return;
  }
  Chat.sendMessage(content);
  input.value = '';
  input.style.height = 'auto';
  input.focus();
};

// 绑定回车发送（在 app.js 启动后调用）
window.bindChatInputKeys = function() {
  const input = document.getElementById('chatInput');
  if (!input || input.__keyBound) return;
  input.__keyBound = true;

  input.addEventListener('keydown', function(e) {
    // 注意：原生 DOM 事件没有 nativeEvent（那是 React 的属性），
    // 之前写成 e.nativeEvent.isComposing 会在每次按键时抛 TypeError，导致 Enter 完全失效。
    const composing = e.isComposing === true
      || e.keyCode === 229                       // 部分输入法在组合输入时置 229
      || (e.nativeEvent && e.nativeEvent.isComposing === true);

    if (e.key === 'Enter' && !e.shiftKey && !composing) {
      e.preventDefault();
      e.stopPropagation();
      try {
        window.sendChat();
      } catch (err) {
        console.error('[VideoForge] 发送失败:', err);
        if (window.Toast) Toast.error('发送失败：' + (err.message || err));
      }
    }
  });

  // 自动增高
  input.addEventListener('input', function() {
    input.style.height = 'auto';
    input.style.height = Math.min(input.scrollHeight, 200) + 'px';
  });

  // ★ 拖文件到输入区 = 添加附件（用户第一反应就是拖过来）
  const area = document.getElementById('chatInputArea');
  if (area && !area.__dropBound) {
    area.__dropBound = true;
    area.addEventListener('dragover', (e) => {
      e.preventDefault();
      area.classList.add('dragging');
    });
    area.addEventListener('dragleave', () => area.classList.remove('dragging'));
    area.addEventListener('drop', (e) => {
      e.preventDefault();
      area.classList.remove('dragging');
      const files = (e.dataTransfer && e.dataTransfer.files)
        ? Array.from(e.dataTransfer.files) : [];
      if (files.length) Chat.uploadAttachments(files);
    });
  }
};

/**
 * 把**工具调用 JSON** 从给用户看的正文里摘掉（2026-09-28，用户第 4 条）。
 *
 * 用户原话：「对话过程中代码不要出现！用户是来交互的，不是来技术探讨的」。
 *
 * 实测为什么会出现：模型有时不"调工具"，而是**把计划列给用户看** ——
 *     ### 1. 确认项目状态
 *     ```json
 *     {"tool": "pipeline_status", "args": {...}}
 *     ```
 *     ### 2. 提取资产
 *     ```json
 *     {"tool": "extract_assets", "args": {...}}
 *     ```
 * 这种"散文 + 多个 JSON 块"的形态 `parse_action` 不会执行（它只认**整条就是一个**
 * JSON 对象），于是整段原样当答复显示 —— 用户看到的就是一屏代码。
 *
 * 这里做两件事（都不改数据，只改**显示**）：
 *   ① 解析出里面**第一个**工具调用 → 返回它，让上层可以真的去做
 *      （见 sendMessage 里对 `_extractPlannedTool` 的使用）；
 *   ② 显示时把这些 JSON 代码块换成人话（「正在执行：pipeline_status」），
 *      并去掉 ```json 围栏 —— 用户永远看不到原始 JSON。
 */
function _extractPlannedTool(text) {
  const out = { tool: null, cleaned: String(text == null ? '' : text) };
  const src = String(text || '');
  if (!src || src.indexOf('"tool"') < 0) return out;
  // 找所有 { ... "tool": "x" ... }（含围栏内外的）
  const re = /\{[^{}]*"tool"\s*:\s*"([A-Za-z0-9_]+)"[^{}]*(?:\{[^{}]*\}[^{}]*)*\}/g;
  let m, first = null;
  let cleaned = src;
  while ((m = re.exec(src)) !== null) {
    if (!first) {
      try {
        first = JSON.parse(m[0]);
      } catch (e) {
        try { first = JSON.parse(m[0].replace(/,\s*([}\]])/g, '$1')); } catch (e2) { first = null; }
      }
    }
  }
  if (!first) return out;
  // 把 JSON 代码块（```json ... ``` 或裸的 {...} 工具调用）换成人话
  cleaned = cleaned
    .replace(/```(?:json)?\s*\{[^`]*?"tool"[^`]*?\}\s*```/g,
             (mm) => {
               const t = /"tool"\s*:\s*"([A-Za-z0-9_]+)"/.exec(mm);
               return t ? `\n（正在执行：\`${t[1]}\`）\n` : '';
             })
    .replace(/\{[^{}]*"tool"\s*:\s*"[A-Za-z0-9_]+"[^{}]*(?:\{[^{}]*\}[^{}]*)*\}/g,
             (mm) => {
               const t = /"tool"\s*:\s*"([A-Za-z0-9_]+)"/.exec(mm);
               return t ? `（正在执行：\`${t[1]}\`）` : '';
             });
  out.tool = first;
  out.cleaned = cleaned;
  return out;
}

// 全局工具
function escapeHtml(s) {
  if (!s) return '';
  return String(s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}
window.escapeHtml = escapeHtml;

/**
 * 视频加载失败时的兜底（2026-09-27 第 72 轮）。
 *
 * ★ 为什么必须有：用户报「对话框里面的视频看不了」—— 而**播放器只会显示
 *   一个 0:00 的空白框**，既不报错也不说为什么，用户只能干看着。
 *   这里做三件事：
 *     ① 把失败**说出来**（附上真实 src，便于一眼看出是路径错还是文件缺）；
 *     ② 给一个「在系统播放器里打开」的按钮（桌面版直接调后端 shell 打开，
 *        绕开浏览器/WebView2 的编解码差异 —— 这是"一定能看"的那条路）；
 *     ③ 保留「下载」，用户至少能把文件拿走。
 */
window.__vfVideoError = function (el) {
  try {
    const card = el.closest('.agent-media-card') || el.parentElement;
    const box = card && card.querySelector('.agent-media-fallback');
    const src = el.getAttribute('src') || '';
    const info = '视频没能播放（浏览器加载失败）。源地址：' + src;
    if (box) {
      box.hidden = false;
      box.innerHTML = '<div class="agent-err" style="font-size:12px">'
        + window.escapeHtml(info) + '</div>';
    }
    console.warn('[chat] 视频加载失败：', src);
  } catch (e) { /* 兜底本身出错不能影响别处 */ }
};
